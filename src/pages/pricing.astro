---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import Faq from '../components/Faq.astro';
import Button from '../components/Button.astro';

import imgStart from '../assets/img/pricing/start.png';
import imgMid from '../assets/img/pricing/mid.png';
import imgPro from '../assets/img/pricing/pro.png';
import blobBg from '../assets/img/pricing/blob-bg.svg';

const tiers = [
  {
    title: "Una soluzione che cresce con l'azienda",
    image: imgStart,
    points: [
      'Startup rapido, contatto diretto',
      'Supporto costante da chi parla la tua lingua',
      "Ogni dato inserito diventa un patrimonio di know-how che aumenta il valore dell'impresa",
    ],
  },
  {
    title: 'Un investimento proporzionale',
    image: imgMid,
    points: [
      'Software snello, paghi solo quello che usi',
      'Funzioni proporzionate alle necessità',
      'Attenzione alle PMI, soluzioni livello corporate',
    ],
  },
  {
    title: 'Da 0 a regime in sei mesi',
    image: imgPro,
    points: [
      'Primi giorni: Audit di Maturità Digitale di dominio',
      '0-5 mesi: Setup, onboarding, roll out',
      'Dal 6° mese: Analisi finale ROI + Scale up',
    ],
  },
];

const roi = [
  { problem: 'Riduzione Costi Diretti', benefit: 'Risparmio 15-20%', tone: 'teal' },
  { problem: 'Tracciamento costi', benefit: 'Per singolo intervento e ricambio', tone: 'orange' },
  { problem: 'Ottimizzazione gestione Ricambi', benefit: 'Niente emergenze né giacenze', tone: 'teal' },
  { problem: 'Controllo su contratti e listini fornitori', benefit: 'Maggior potere contrattuale', tone: 'orange' },
  { problem: 'Da know-how frammentato', benefit: 'Ad archivio tecnico strutturato', tone: 'teal' },
];

const faqs = [
  { q: "L'evoluzione della piattaforma OpenEAM è inclusa nell'investimento?", a: 'Assolutamente sì. Crediamo in una partnership a lungo termine. Tutti gli aggiornamenti, le nuove funzionalità e i miglioramenti di sicurezza rilasciati per i moduli attivi sono inclusi nel vostro canone, garantendovi di avere sempre a disposizione la tecnologia più avanzata senza costi nascosti.' },
  { q: "Qual è l'investimento richiesto per la fase di setup iniziale?", a: "La fase di setup non è un costo fisso, ma un percorso su misura. Include il nostro Audit di Maturità Digitale e la configurazione della piattaforma sui vostri processi. L'investimento dipende dalla complessità e dai moduli attivi, ed è calibrato per essere sostenibile e generare risparmi misurabili già nelle prime settimane, coprendo rapidamente l'esborso iniziale." },
  { q: 'Sono previste agevolazioni per organizzazioni non profit o progetti speciali?', a: "Sì, OpenEAM sostiene l'efficienza anche nel terzo settore. Valutiamo piani d'investimento specifici e agevolati per organizzazioni non profit e progetti a impatto sociale, previa verifica dei requisiti." },
  { q: "Qual è la flessibilità dell'impegno contrattuale con OpenEAM?", a: "La nostra filosofia si basa sul valore: vogliamo che restiate con noi perché OpenEAM vi fa risparmiare, non per un vincolo contrattuale. Per il modello Cloud (SaaS), offriamo la massima flessibilità di adeguare o interrompere il piano. Il vostro controllo sulla soluzione è totale e l'esportazione dei dati è sempre garantita." },
  { q: 'Come si adatta OpenEAM se la mia azienda cresce o le esigenze cambiano?', a: "OpenEAM è nativamente scalabile. Se la vostra squadra si amplia o avete bisogno di tracciare nuovi processi, potete aggiungere utenti o attivare nuovi moduli in qualsiasi momento. L'investimento si adeguerà proporzionalmente all'uso effettivo, garantendo che paghiate sempre e solo per il valore che ricevete." },
  { q: 'Come posso essere sicuro che OpenEAM genererà un reale risparmio per la mia azienda?', a: "Non ci basiamo su promesse, ma su dati. Nel percorso di setup, definiremo insieme i KPI da monitorare. OpenEAM traccia ogni costo e inefficienza, permettendovi di misurare l'abbattimento dei costi diretti (15-20% mediamente nei primi mesi) e il ROI in tempi rapidi, spesso tra i 6 e i 12 mesi." },
  { q: 'La mia azienda ha processi molto specifici. OpenEAM riuscirà a tracciarli e controllarli?', a: 'Sì. A differenza di software standard, la nostra forza è la personalizzazione. Grazie all\'Audit iniziale e alla modularità della piattaforma, OpenEAM "prende la forma" dei vostri processi specifici. Questo vi garantisce una tracciabilità totale e un controllo a prova di audit, riducendo drasticamente i rischi operativi.' },
  { q: 'Qual è la differenza principale tra OpenEAM e i sistemi Legacy più blasonati?', a: 'Agilità e focus sul valore. Mentre i sistemi Legacy richiedono investimenti enormi, lunghi tempi di implementazione e spesso sono rigidi, OpenEAM offre una soluzione Enterprise agile, un go-live rapido e un modello di investimento flessibile che mira a un ROI veloce e a un controllo granulare del processo, senza i costi di manutenzione IT dei vecchi sistemi.' },
];
---
<BaseLayout title="Pricing" description="Un investimento calibrato e proporzionale: SaaS o on-premise. OpenEAM è progettato per ripagarsi entro i primi 12 mesi.">

  <!-- Hero statement -->
  <Section bg="light" class="pricing-hero">
    <Image src={blobBg} alt="" class="pricing-hero__blob" aria-hidden="true" />
    <p class="price-hero">
      L'investimento iniziale è calibrato per permettere di <span class="hl">testare la tecnologia</span>
      senza pesare sul budget in corso, garantendo la sostenibilità finanziaria nel tempo.
    </p>
  </Section>

  <!-- Tiers -->
  <Section bg="light">
    <div class="tiers">
      {tiers.map((t) => (
        <article class="tier card">
          <div class="tier__img"><Image src={t.image} alt="" width={260} height={200} loading="lazy" /></div>
          <h3 class="tier__title">{t.title}</h3>
          <ul class="tier__list">
            {t.points.map((p) => <li>{p}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </Section>

  <!-- SaaS / On premise -->
  <Section bg="light">
    <div class="plans">
      <div class="plan card">
        <h3 class="plan__title">SaaS</h3>
        <p class="plan__body">Un canone mensile proporzionato ai moduli attivi, al numero di stabilimenti e di utenti.</p>
      </div>
      <div class="plan card">
        <h3 class="plan__title">On premise</h3>
        <p class="plan__body">Se hai esigenze di sicurezza o compliance specifiche, puoi installare Open EAM sui tuoi server.</p>
      </div>
    </div>
  </Section>

  <!-- ROI -->
  <Section bg="light">
    <div class="roi">
      <div class="roi__narrative card">
        <h2 class="roi__title">Un ROI <span class="hl">tangibile</span></h2>
        <p class="roi__lead">Non puoi gestire ciò che non misuri. Con Open EAM, ogni centesimo è tracciato.</p>
        <p>OpenEAM è progettato per ripagarsi da solo entro i primi <strong>12 mesi</strong> grazie all'eliminazione dei fermi macchina e delle inefficienze nascoste.</p>
        <p><strong>Risparmio Strutturale:</strong> la manutenzione programmata abbatte i costi d'urgenza (i più cari) fino al 40%.</p>
        <p><strong>Estensione vita degli Asset:</strong> tracciare tutto significa far durare gli impianti il 25% in più, posticipando investimenti milionari in nuovi impianti.</p>
        <p><strong>Consolidamento Software:</strong> sostituisci i sistemi legacy (documentali, reporting, CMMS) con un'unica piattaforma.</p>
      </div>
      <div class="roi__grid card">
        {roi.map((r) => (
          <div class="roi__row">
            <span class="chip chip--problem">{r.problem}</span>
            <span class:list={['chip', `chip--${r.tone}`]}>→ {r.benefit}</span>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- Contact CTA -->
  <Section bg="light">
    <div class="contact-cta">
      <Button href="/demo" variant="primary" class="contact-cta__btn">Contattaci</Button>
    </div>
  </Section>

  <!-- Trust -->
  <Section bg="teal">
    <LogoMarquee />
  </Section>

  <!-- FAQ -->
  <Section bg="white">
    <SectionHeading heading="Domande frequenti" />
    <div class="faq-wrap"><Faq items={faqs} /></div>
  </Section>

</BaseLayout>

<style>
  .pricing-hero { position: relative; overflow: hidden; }
  .pricing-hero__blob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(120%, 1400px);
    height: auto;
    transform: translate(-50%, -50%) scale(1.4);
    opacity: 1;
    pointer-events: none;
    z-index: 0;
  }
  .pricing-hero :global(.container-page) { position: relative; z-index: 1; }

  @keyframes price-rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .price-hero {
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
    text-wrap: balance;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3.6vw, 2.6rem);
    line-height: 1.3;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    animation: price-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .price-hero .hl { color: var(--color-orange); }
  @media (prefers-reduced-motion: reduce) {
    .price-hero { animation: none; }
  }

  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .tier {
    padding: 2rem; display: grid; gap: 1.25rem; align-content: start; text-align: center;
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tier:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -20px rgb(35 48 56 / 0.3); }
  .tier__img { display: grid; place-items: center; min-height: 150px; }
  .tier__img :global(img) { width: auto; max-height: 160px; object-fit: contain; }
  .tier__title { font-size: 1.3rem; }
  .tier__list { list-style: none; display: grid; gap: 0.7rem; text-align: left; }
  .tier__list li {
    position: relative; padding-left: 1.4rem;
    color: var(--color-slate); font-size: 0.95rem; line-height: 1.5;
  }
  .tier__list li::before { content: '✓'; position: absolute; left: 0; color: var(--color-orange); font-weight: 700; }
  @media (max-width: 860px) { .tiers { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) {
    .tier { transition: none; }
    .tier:hover { transform: none; }
  }

  .plans { display: grid; gap: 1.5rem; }
  .plan { padding: 1.75rem 2.25rem; display: grid; grid-template-columns: 220px 1fr; gap: 1.5rem; align-items: center; }
  .plan__title { font-size: 1.7rem; }
  .plan__body { color: var(--color-slate); font-size: 1.05rem; }
  @media (max-width: 640px) { .plan { grid-template-columns: 1fr; gap: 0.5rem; } }

  .roi { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; }
  .roi__narrative { padding: 2.25rem; display: grid; gap: 0.9rem; }
  .roi__title { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .roi__title .hl { color: var(--color-orange); }
  .roi__lead { font-weight: 600; color: var(--color-ink); font-size: 1.1rem; }
  .roi__narrative p { color: var(--color-slate); font-size: 0.98rem; line-height: 1.6; }
  .roi__grid { padding: 1.75rem; display: grid; gap: 0.9rem; align-content: center; }
  .roi__row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .chip {
    display: flex; align-items: center;
    padding: 0.75rem 1rem; border-radius: 12px;
    font-size: 0.88rem; font-weight: 600; line-height: 1.25;
  }
  .chip--problem { background: #d2d8d9; color: var(--color-ink); }
  .chip--teal { background: #46a5a3; color: #fff; }
  .chip--orange { background: #f58b54; color: #fff; }
  @media (max-width: 860px) { .roi { grid-template-columns: 1fr; } }

  .contact-cta { display: flex; justify-content: center; }
  .contact-cta__btn { font-size: 1.1rem; padding-inline: 3rem; }

  .faq-wrap { margin-top: 2.5rem; }
</style>
