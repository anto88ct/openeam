---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ModuleCard from '../components/ModuleCard.astro';
import Testimonial from '../components/Testimonial.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import CtaBand from '../components/CtaBand.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Button from '../components/Button.astro';

import heroRings from '../assets/img/hero-rings.svg';
import featAsset from '../assets/img/feat-asset-management.avif';
import featMaint from '../assets/img/feat-maintenance.avif';
import featDoc from '../assets/img/feat-documentation.avif';
import featAnalytics from '../assets/img/feat-analytics.avif';
import workerIndustry from '../assets/img/worker-industry.avif';
import iconGear from '../assets/icons/gear.svg';
import iconWrench from '../assets/icons/wrench.svg';
import iconDocument from '../assets/icons/document.svg';
import iconChart from '../assets/icons/chart.svg';
import caseSt from '../assets/img/cases/st.png';
import caseSonatrach from '../assets/img/cases/sonatrach.avif';
import caseSasol from '../assets/img/cases/sasol.avif';
import caseSac from '../assets/img/cases/sac.avif';

const modules = [
  {
    href: '/platform/asset-management',
    heading: 'Asset Management',
    icon: iconGear,
    body: 'Ottimizza il ciclo di vita degli asset con <strong>gestione centralizzata</strong>, <strong>visibilità completa</strong> e <strong>integrazione dei dati</strong>, anche in organizzazioni multisito con strutture complesse.',
    image: featAsset,
  },
  {
    href: '/platform/maintenance-operations',
    heading: 'Maintenance & Operations',
    icon: iconWrench,
    body: 'Pianifica, traccia e ottimizza attività manutentive <strong>programmate</strong>, <strong>predittive</strong> e <strong>correttive</strong> con flussi personalizzati sulle tue procedure e sui tuoi impianti, riducendo downtime e sprechi di risorse.',
    image: featMaint,
  },
  {
    href: '/platform/technical-documentation',
    heading: 'Technical Documentation',
    icon: iconDocument,
    body: 'Centralizza e collega la documentazione tecnica agli asset, integrandola nei flussi operativi per un <strong>accesso immediato</strong> e <strong>sicuro</strong>, ovunque ti trovi.',
    image: featDoc,
  },
  {
    href: '/platform/asset-analytics',
    heading: 'Asset Analytics',
    icon: iconChart,
    body: 'Trasforma dati IoT, geospaziali e digital twin in <strong>insight</strong> immediatamente azionabili, con <strong>KPI</strong> e <strong>dashboard</strong> sempre disponibili per essere utilizzati nei processi decisionali.',
    image: featAnalytics,
  },
];

const cases = [
  { title: 'ST Microelectronics', href: '/case-studies/st-microelectronics', image: caseSt, body: "Oltre 40.000 interventi gestiti ogni anno e più dell'80% di attività pianificate: con Open EAM, STMicroelectronics ha trasformato la gestione della manutenzione." },
  { title: 'Sonatrach', href: '/case-studies/sonatrach', image: caseSonatrach, body: "Nei depositi di Augusta, Napoli e Palermo, Sonatrach usa Open EAM per gestire manutenzione, ispezioni e controlli navi in un'unica piattaforma." },
  { title: 'Sasol', href: '/case-studies/sasol', image: caseSasol, body: 'Sasol usa Open EAM per gestire 60.000 documenti tecnici, revisioni, manuali operativi e ispezioni antincendio in un\'unica piattaforma integrata.' },
  { title: 'SAC', href: '/case-studies/sac', image: caseSac, body: "SAC adotta Open EAM per gestire asset, ispezioni, ticket e documentazione tecnica in un'unica piattaforma di manutenzione integrata." },
];
---
<BaseLayout title="OpenEAM, la Piattaforma Modulare che Prende la Forma dei Tuoi Processi" description="Open EAM unisce manutenzione, asset management e controllo operativo in un'unica piattaforma flessibile che si adatta ai tuoi processi. E non viceversa.">

  <!-- Hero -->
  <section class="hero">
    <div class="hero__grid dotted-grid container-page">
      <div class="hero__text">
        <h1 class="hero__title">
          Mantieni i tuoi asset industriali <span class="hero__hl">al massimo dell'efficienza.</span>
        </h1>
        <p class="hero__sub">
          Open EAM è la piattaforma che unisce manutenzione, asset management e controllo
          operativo in un unico sistema flessibile, che si adatta ai tuoi processi.
          <strong>E non viceversa.</strong>
        </p>
        <div class="hero__cta">
          <Button href="/demo" variant="primary">Richiedi una demo</Button>
          <Button href="/demo" variant="outline">Video tour della piattaforma</Button>
        </div>
      </div>
    </div>
    <Image src={heroRings} alt="" class="hero__rings" aria-hidden="true" />
  </section>

  <!-- Trust band -->
  <Section bg="teal">
    <LogoMarquee />
  </Section>

  <!-- Modules -->
  <Section bg="light" dotted>
    <SectionHeading
      heading="Manutenzione, asset management, documenti e analytics in una piattaforma che prende la forma dei tuoi processi"
      sub="Open EAM racchiude in un unico sistema <strong>modulare</strong> e <strong>personalizzabile</strong> tutte le funzioni necessarie a mantenere impianti produttivi organizzati e performanti, a ridurre i fermi impianto e a migliorare l'efficienza."
    />
    <div class="modules">
      {modules.map((m, i) => (
        <ModuleCard
          icon={m.icon}
          title={m.heading}
          body={m.body}
          href={m.href}
          image={m.image}
          reverse={i % 2 === 1}
        />
      ))}
    </div>
    <div class="modules__cta">
      <Button href="/demo" variant="teal">Richiedi una demo</Button>
    </div>
  </Section>

  <!-- Testimonial -->
  <Section bg="light">
    <Testimonial
      quote="Open EAM ha reso semplice ciò che prima era frammentato: oggi gestiamo manutenzione, ispezioni e asset su un'unica piattaforma, che sembra cucita addosso a noi."
      author="Francesco Vassallo"
      company="Sonatrach"
    />
  </Section>

  <!-- Modular architecture band -->
  <Section bg="light">
    <CtaBand
      tone="ink"
      image={workerIndustry}
      imageAlt="Operatore al lavoro in impianto industriale"
      heading="Un'architettura modulare, costruita attorno ai tuoi processi"
      body="Non piegare i tuoi processi alle regole di un software preconfezionato. Scopri l'EAM modulare costruito a misura della tua azienda."
      ctaLabel="Vai al video tour della piattaforma"
      ctaHref="/demo"
    />
  </Section>

  <!-- Case studies -->
  <Section bg="light">
    <SectionHeading
      heading="Casi studio"
      sub="Scopri come altre aziende utilizzano Open EAM per migliorare l'efficienza e le performance della manutenzione nei loro impianti produttivi."
    />
    <div class="cases-grid">
      {cases.map((c) => (
        <CaseStudyCard title={c.title} href={c.href} image={c.image} imageAlt={c.title} body={c.body} />
      ))}
    </div>
    <div class="modules__cta">
      <Button href="/case-studies" variant="outline-ink">Esplora tutti i case studies</Button>
    </div>
  </Section>

</BaseLayout>

<style>
  .hero { position: relative; background: var(--color-ink); overflow: hidden; }
  .hero__grid { padding-block: clamp(4rem, 10vw, 8rem); position: relative; z-index: 1; }
  .hero__text { max-width: 42rem; display: grid; gap: 2rem; }
  .hero__title { color: #fff; font-size: clamp(2.6rem, 6.5vw, 4.6rem); line-height: 1.03; }
  .hero__hl { color: var(--color-orange); }
  .hero__sub { color: rgb(255 255 255 / 0.9); font-size: 1.25rem; max-width: 46ch; line-height: 1.6; }
  .hero__sub strong { color: #fff; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero__title,
  .hero__sub,
  .hero__cta {
    animation: hero-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero__title { animation-delay: 0.05s; }
  .hero__sub { animation-delay: 0.16s; }
  .hero__cta { animation-delay: 0.27s; }
  .hero__rings {
    position: absolute;
    right: -5%;
    bottom: -10%;
    width: min(62%, 880px);
    height: auto;
    opacity: 1;
    pointer-events: none;
    z-index: 0;
  }
  @media (max-width: 860px) {
    .hero__rings { opacity: 0.22; right: -25%; bottom: -6%; width: 90%; }
  }

  .modules { display: grid; gap: 2rem; margin-top: 3.5rem; }
  .modules__cta { display: flex; justify-content: center; margin-top: 3rem; }

  .cases-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 3.5rem;
  }
  @media (max-width: 720px) { .cases-grid { grid-template-columns: 1fr; } }
</style>
