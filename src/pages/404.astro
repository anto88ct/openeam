---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Pagina non trovata" description="La pagina che cerchi non esiste.">
  <section class="nf">
    <div class="container-page nf__inner dotted-grid">
      <p class="nf__code">404</p>
      <h1 class="nf__title">Questa pagina si è persa in officina.</h1>
      <p class="nf__sub">La pagina che cerchi non esiste o è stata spostata.</p>
      <div class="nf__cta">
        <Button href="/" variant="primary">Torna alla home</Button>
        <Button href="/demo" variant="outline">Richiedi una demo</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { background: var(--color-ink); }
  .nf__inner {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    padding-block: clamp(5rem, 14vw, 9rem);
  }
  .nf__code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 8rem);
    color: var(--color-orange);
    line-height: 1;
  }
  .nf__title { color: #fff; font-size: clamp(1.6rem, 4vw, 2.4rem); }
  .nf__sub { color: var(--color-on-dark); }
  .nf__cta { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 1rem; }
</style>
