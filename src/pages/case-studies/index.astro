---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';

const items = (await getCollection('caseStudies'))
  .filter((c) => !c.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Case Studies"
  description="Scopri come le aziende industriali usano Open EAM per migliorare efficienza e performance della manutenzione."
>
  <Section bg="ink" dotted>
    <SectionHeading
      heading="Casi studio"
      sub="Scopri come altre aziende utilizzano Open EAM per migliorare l'efficienza e le performance della manutenzione nei loro impianti produttivi."
    />
  </Section>

  <Section bg="light">
    <div class="cs-grid">
      {items.map((c) => (
        <CaseStudyCard
          title={c.data.title}
          href={`/case-studies/${c.id}`}
          image={c.data.heroImage}
          imageAlt={c.data.title}
          body={c.data.excerpt}
        />
      ))}
    </div>
  </Section>
</BaseLayout>

<style>
  .cs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  @media (max-width: 940px) { .cs-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .cs-grid { grid-template-columns: 1fr; } }
</style>
