---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import Button from '../../components/Button.astro';

export async function getStaticPaths() {
  const items = (await getCollection('caseStudies')).filter((c) => !c.data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
---
<BaseLayout
  title={`${data.title} — Case Study`}
  description={data.seoDescription ?? data.excerpt}
>
  <PhotoHero image={data.heroImage} heading={data.title} sub={data.industry} ctaLabel="" />

  {data.metrics.length > 0 && (
    <Section bg="ink">
      <ul class="metrics">
        {data.metrics.map((m) => (
          <li class="metric">
            <span class="metric__value">{m.value}</span>
            <span class="metric__label">{m.label}</span>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <Section bg="white">
    <div class="cs-layout">
      <article class="cs-prose">
        <Content />
      </article>
      <aside class="cs-aside">
        {data.modules.length > 0 && (
          <div class="cs-modules">
            <h3>Moduli Open EAM utilizzati</h3>
            <ul>
              {data.modules.map((m) => <li>{m}</li>)}
            </ul>
          </div>
        )}
        <Button href="/demo" variant="primary">Richiedi una demo</Button>
      </aside>
    </div>
  </Section>

  <Section bg="light">
    <div class="cs-back">
      <Button href="/case-studies" variant="outline-ink">← Tutti i case studies</Button>
    </div>
  </Section>
</BaseLayout>

<style>
  .metrics {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2rem;
    text-align: center;
  }
  .metric { display: grid; gap: 0.4rem; }
  .metric__value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    color: var(--color-orange);
    line-height: 1;
  }
  .metric__label { color: var(--color-on-dark); font-size: 0.98rem; }

  .cs-layout { display: grid; grid-template-columns: 1fr 300px; gap: 3rem; align-items: start; }
  .cs-prose :global(h2) { font-size: 1.5rem; margin: 2rem 0 0.75rem; }
  .cs-prose :global(h2:first-child) { margin-top: 0; }
  .cs-prose :global(p) { margin-bottom: 1.1rem; color: var(--color-slate); line-height: 1.7; }
  .cs-prose :global(ul) { margin: 0 0 1.1rem 1.2rem; display: grid; gap: 0.4rem; color: var(--color-slate); }
  .cs-prose :global(strong) { color: var(--color-ink); }

  .cs-aside { position: sticky; top: 100px; display: grid; gap: 1.5rem; }
  .cs-modules {
    background: var(--color-bg);
    border-radius: var(--radius-card);
    padding: 1.5rem;
  }
  .cs-modules h3 { font-size: 1rem; margin-bottom: 0.75rem; }
  .cs-modules ul { list-style: none; display: grid; gap: 0.5rem; }
  .cs-modules li {
    font-size: 0.9rem;
    color: var(--color-slate-muted);
    padding-left: 1.1rem;
    position: relative;
  }
  .cs-modules li::before { content: '→'; position: absolute; left: 0; color: var(--color-orange); }

  .cs-back { display: flex; justify-content: center; }

  @media (max-width: 820px) {
    .cs-layout { grid-template-columns: 1fr; }
    .cs-aside { position: static; }
  }
</style>
