---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import PlatformHero from '../../components/PlatformHero.astro';
import FeatureSplit from '../../components/FeatureSplit.astro';
import CtaBand from '../../components/CtaBand.astro';
import LottiePlayer from '../../components/LottiePlayer.astro';

import heroPhoto from '../../assets/img/control-panel.avif';
import closingPhoto from '../../assets/img/worker-industry.avif';

const features = [
  {
    heading: 'Struttura solida e scalabile dei tuoi asset',
    body: 'Organizza tutti gli asset, dagli impianti industriali alle attrezzature, in una struttura coerente e facilmente navigabile. La modularità della piattaforma ti consente di partire con la configurazione essenziale e ampliarla nel tempo, restando sempre allineata ai tuoi processi.',
    anim: 'Verniciatura_Essicazione_Movimentazione',
  },
  {
    heading: 'Gestione multisito e localizzazioni complesse',
    body: 'Gestire sedi e impianti in più località non significa rinunciare alla coerenza operativa. Open EAM ti permette di mappare, monitorare e intervenire su asset distribuiti mantenendo procedure e standard condivisi. I flussi di lavoro sono modellati sulle esigenze di ogni sito, ma coordinati in un unico sistema centrale.',
    anim: 'Verono_Roma_Catania',
  },
  {
    heading: 'Integrazione intelligente dei dati (ETL)',
    body: 'Collega Open EAM alle tue fonti dati (ERP, SCADA, IoT o database esterni) e trasforma informazioni eterogenee in un patrimonio unico e coerente. Grazie ai processi ETL nativi, i dati vengono uniformati e integrati nei tuoi flussi, così non dovrai cambiare strumenti o procedure collaudate.',
    anim: 'file_cad_open_EAM_modello_BIM',
  },
];
---
<BaseLayout title="Asset Management — OpenEAM Platform" description="OpenEAM centralizza e organizza ogni asset in una struttura solida, scalabile e flessibile, modellandosi sui tuoi processi per contesti multi-sito e complessi.">

  <PlatformHero
    tone="ink"
    accent="orange"
    icon="gear"
    headingLead="Asset"
    headingAccent="management"
    sub="OpenEAM centralizza e organizza ogni asset in una struttura solida, scalabile e flessibile. A differenza degli EAM tradizionali, non sei tu ad adattarti al software: la piattaforma si modella sui tuoi processi, permettendoti di operare in contesti multi-sito, complessi e in continua evoluzione."
  >
    <Image src={heroPhoto} alt="Quadro di controllo industriale" width={720} height={540} />
  </PlatformHero>

  <Section bg="white">
    <div class="stack">
      {features.map((f) => (
        <FeatureSplit heading={f.heading} body={f.body}>
          <div class="lottie-box">
            <LottiePlayer animationName={f.anim} ariaLabel={f.heading} />
          </div>
        </FeatureSplit>
      ))}
    </div>
  </Section>

  <Section bg="white">
    <CtaBand
      tone="ink"
      image={closingPhoto}
      imageAlt="Operatore in impianto"
      heading="Un'architettura modulare, costruita attorno ai tuoi processi"
      body="Non piegare i tuoi processi alle regole di un software preconfezionato. Scopri l'EAM modulare costruito a misura della tua azienda."
    />
  </Section>

</BaseLayout>

<style>
  .stack { display: grid; gap: 2rem; }
  .lottie-box { width: 100%; min-height: 300px; display: grid; place-items: center; }
</style>
