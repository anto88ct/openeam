---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import PlatformHero from '../../components/PlatformHero.astro';
import FeatureSplit from '../../components/FeatureSplit.astro';
import CtaBand from '../../components/CtaBand.astro';
import LottiePlayer from '../../components/LottiePlayer.astro';

import heroPhoto from '../../assets/img/bar-chart-presentation.avif';
import closingPhoto from '../../assets/img/worker-industry.avif';

const features = [
  {
    heading: 'Dati in tempo reale connessi via IoT',
    body: 'Integra Open EAM con sensori, PLC e sistemi SCADA per avere una visione costante e aggiornata delle condizioni operative degli asset. I dati arrivano in tempo reale e vengono automaticamente associati a ciascun asset.',
    anim: 'dashboar_with_sensore_allarme',
  },
  {
    heading: 'Business Intelligence integrata',
    body: 'Con gli strumenti di Business Intelligence nativi, Open EAM trasforma dati complessi in visualizzazioni intuitive e report personalizzati. Puoi analizzare prestazioni, costi, frequenza degli interventi e trend di utilizzo, identificando aree di inefficienza o di miglioramento.',
    anim: 'dashboard_insight_immediati',
  },
  {
    heading: 'Analisi geospaziale e digital twin',
    body: 'La piattaforma integra funzionalità GIS e digital twin per dare un contesto visivo e operativo ai tuoi asset. Puoi visualizzare la distribuzione geografica, simulare scenari di utilizzo e pianificare interventi considerando vincoli e opportunità legati alla posizione fisica.',
    anim: 'house_with_dots',
  },
  {
    heading: 'KPI sempre sotto controllo',
    body: 'Definisci i KPI più rilevanti per il tuo business e monitora le performance con aggiornamenti automatici e costanti. Che si tratti di MTBF (Mean Time Between Failures), tempi di intervento o costi di fermo macchina, Open EAM ti fornisce un quadro chiaro e confrontabile nel tempo, così puoi misurare l\'efficacia delle azioni intraprese e adattare rapidamente le strategie operative.',
    anim: 'dashboard_MTBF_tempi_intervento_costi_fermo',
  },
];
---
<BaseLayout title="Asset Analytics — OpenEAM Platform" description="Open EAM trasforma flussi di dati IoT, sensori e sistemi esterni in analisi chiare e centralizzate, con dashboard e KPI sempre aggiornati.">

  <PlatformHero
    tone="light"
    accent="orange"
    icon="chart"
    headingLead="Asset"
    headingAccent="analytics"
    sub="Open EAM trasforma flussi di dati IoT, sensori e sistemi esterni in analisi chiare e centralizzate. Con dashboard e KPI sempre aggiornati, puoi monitorare asset, anticipare problemi e ottimizzare performance in tempo reale."
  >
    <Image src={heroPhoto} alt="Analisi dati e dashboard su schermo" width={720} height={540} />
  </PlatformHero>

  <Section bg="white">
    <div class="stack">
      {features.map((f) => (
        <FeatureSplit heading={f.heading} body={f.body}>
          <div class="lottie-box">
            <LottiePlayer animationName={f.anim} ariaLabel={f.heading} />
          </div>
        </FeatureSplit>
      ))}
    </div>
  </Section>

  <Section bg="white">
    <CtaBand
      tone="sage"
      image={closingPhoto}
      imageAlt="Operatore in impianto"
      heading="Dai dati al valore, in tempo reale"
      body="Con Open EAM, ogni informazione è connessa, analizzata e tradotta in insight operativi e strategici. Non solo vedi cosa sta accadendo: capisci perché e sai come agire."
    />
  </Section>

</BaseLayout>

<style>
  .stack { display: grid; gap: 2rem; }
  .lottie-box { width: 100%; min-height: 300px; display: grid; place-items: center; }
</style>
