---
import { getCollection } from 'astro:content';
import CaseStudyDetail from '../../../components/pages/CaseStudyDetail.astro';

export async function getStaticPaths() {
  const items = (await getCollection('caseStudiesEn')).filter((c) => !c.data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---
<CaseStudyDetail lang="en" entry={entry} />
