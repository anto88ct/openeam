---
import { getCollection } from 'astro:content';
import IndustryDetail from '../../../components/pages/IndustryDetail.astro';

export async function getStaticPaths() {
  const items = await getCollection('industriesEn');
  return items.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---
<IndustryDetail lang="en" entry={entry} />
