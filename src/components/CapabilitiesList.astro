---
import { Image } from 'astro:assets';

/** Static heading + bullet list next to a photo — single-slide sibling of
    ListPhotoCarousel.astro (which needs 2+ slides for its carousel chrome
    to make sense). Used on Platform pages for a "cosa puoi gestire" recap. */
interface Props {
  heading: string;
  items: string[];
  image: ImageMetadata;
  imageAlt: string;
}
const { heading, items, image, imageAlt } = Astro.props;
---

<div class="caplist reveal">
  <div class="caplist__text">
    <h3 class="caplist__heading">{heading}</h3>
    <ul class="caplist__list">
      {items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
  <div class="caplist__media">
    <Image src={image} alt={imageAlt} width={1200} height={675} loading="lazy" class="caplist__img" />
  </div>
</div>

<script>
  import { initReveal } from '../scripts/reveal';
  document.addEventListener('astro:page-load', initReveal);
  initReveal();
</script>

<style>
  .caplist {
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: stretch;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .caplist__text {
    display: grid;
    gap: 0.75rem;
    align-content: end;
    background: rgb(35 48 56 / 0.07);
    border-radius: var(--radius-card);
    padding: clamp(1.25rem, 2.5vw, 1.5rem);
  }
  .caplist__heading { color: var(--color-ink); font-size: 1.15rem; }
  .caplist__list { display: grid; gap: 0.4rem; }
  .caplist__list li {
    color: var(--color-slate);
    font-size: 0.95rem;
    line-height: 1.4;
    padding-left: 1.1rem;
    position: relative;
  }
  .caplist__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-orange);
  }
  .caplist__media {
    position: relative;
    aspect-ratio: 20 / 9;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .caplist__img { width: 100%; height: 100%; object-fit: cover; display: block; }

  @media (max-width: 820px) {
    .caplist { grid-template-columns: 1fr; }
    .caplist__text { min-height: 220px; }
    .caplist__media { aspect-ratio: 20 / 11; }
  }
</style>
