---
import { Image } from 'astro:assets';
import Button from './Button.astro';

/** Home module card: orange icon + left-aligned text on white, photo w/ teal arc. */
interface Props {
  icon: ImageMetadata;
  title: string;
  body: string;         // may contain <strong>
  href: string;
  image: ImageMetadata;
  reverse?: boolean;    // photo on the left
}
const { icon, title, body, href, image, reverse = false } = Astro.props;
---
<article class:list={['mc', { 'mc--reverse': reverse }]}>
  <div class="mc__text">
    <span class="mc__icon"><Image src={icon} alt="" width={40} height={40} /></span>
    <h3 class="mc__title">{title}</h3>
    <p class="mc__body rich" set:html={body} />
    <Button href={href} variant="primary" class="mc__cta">Scopri di più</Button>
  </div>
  <div class="mc__media">
    <Image src={image} alt={title} width={640} height={520} loading="lazy" />
  </div>
</article>

<style>
  .mc {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    background: #fff;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: clamp(1.75rem, 3vw, 2.75rem);
    overflow: hidden;
  }
  .mc__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    padding: clamp(0.5rem, 2vw, 1.5rem);
  }
  .mc__icon :global(img) { width: 42px; height: 42px; object-fit: contain; }
  .mc__title { font-size: clamp(1.5rem, 2.6vw, 2rem); color: var(--color-ink); }
  .mc__body { color: var(--color-slate); font-size: 1.05rem; line-height: 1.6; max-width: 42ch; }
  .mc__cta { margin-top: 0.5rem; }

  .mc__media {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .mc__media :global(img) {
    width: 100%; height: 100%; object-fit: cover; display: block;
    position: relative; z-index: 1;
  }
  /* teal quarter-circle arc overlay */
  .mc__media::after {
    content: '';
    position: absolute;
    z-index: 2;
    width: 62%;
    aspect-ratio: 1;
    left: -14%;
    bottom: -20%;
    background: var(--color-teal);
    border-radius: 50%;
    opacity: 0.92;
  }
  .mc--reverse .mc__media { order: -1; }
  .mc--reverse .mc__media::after { left: auto; right: -14%; }

  @media (max-width: 820px) {
    .mc { grid-template-columns: 1fr; }
    .mc--reverse .mc__media { order: 0; }
    .mc__media { aspect-ratio: 16 / 10; }
  }
</style>
