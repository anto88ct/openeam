---
import { Image } from 'astro:assets';
import Button from './Button.astro';

/** Autoplaying carousel: stacked stat + body cards on one side, full-bleed photo on the other, dot pagination below. */
interface Slide {
  image: ImageMetadata;
  imageAlt: string;
  statValue: string;
  statLabel: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
}
interface Props {
  slides: Slide[];
  intervalMs?: number;
}
const { slides, intervalMs = 6000 } = Astro.props;
---

<div class="cscarousel" data-carousel data-interval={intervalMs}>
  <div class="cscarousel__row">
    <div class="cscarousel__text">
      {
        slides.map((s, i) => (
          <div class:list={['cscarousel__panel', { 'is-active': i === 0 }]} data-panel={i}>
            <div class="cscarousel__stat">
              <p class="cscarousel__stat-value">{s.statValue}</p>
              <p class="cscarousel__stat-label">{s.statLabel}</p>
            </div>
            <div class="cscarousel__quote">
              <p class="cscarousel__body">{s.body}</p>
              <Button href={s.ctaHref} variant="primary">
                {s.ctaLabel}
              </Button>
            </div>
          </div>
        ))
      }
    </div>
    <div class="cscarousel__media">
      {
        slides.map((s, i) => (
          <Image
            src={s.image}
            alt={s.imageAlt}
            width={1200}
            height={675}
            loading={i === 0 ? 'eager' : 'lazy'}
            class:list={['cscarousel__img', { 'is-active': i === 0 }]}
            data-slide={i}
          />
        ))
      }
    </div>
  </div>
  <div class="cscarousel__dots" role="tablist" aria-label="Casi studio">
    {
      slides.map((_, i) => (
        <button
          type="button"
          class:list={['cscarousel__dot', { 'is-active': i === 0 }]}
          data-dot={i}
          role="tab"
          aria-selected={i === 0}
          aria-label={`Vai alla slide ${i + 1}`}
        />
      ))
    }
  </div>
</div>

<script>
  function initCarousels() {
    document.querySelectorAll<HTMLElement>('[data-carousel]:not([data-cs-inited])').forEach((root) => {
      root.dataset.csInited = 'true';

      const images = Array.from(root.querySelectorAll<HTMLElement>('.cscarousel__img'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('.cscarousel__panel'));
      const dots = Array.from(root.querySelectorAll<HTMLElement>('.cscarousel__dot'));
      const total = images.length;
      if (total < 2) return;

      const interval = Number(root.dataset.interval) || 6000;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let index = 0;
      let timer: ReturnType<typeof setInterval> | null = null;

      const show = (next: number) => {
        images[index]?.classList.remove('is-active');
        panels[index]?.classList.remove('is-active');
        dots[index]?.classList.remove('is-active');
        dots[index]?.setAttribute('aria-selected', 'false');
        index = next;
        images[index]?.classList.add('is-active');
        panels[index]?.classList.add('is-active');
        dots[index]?.classList.add('is-active');
        dots[index]?.setAttribute('aria-selected', 'true');
      };

      const advance = () => show((index + 1) % total);

      const start = () => {
        if (timer || reduceMotion) return;
        timer = setInterval(advance, interval);
      };
      const stop = () => {
        if (timer) clearInterval(timer);
        timer = null;
      };

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          if (i === index) return;
          show(i);
          stop();
          start();
        });
      });

      start();
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);
    });
  }

  document.addEventListener('astro:page-load', initCarousels);
  initCarousels();
</script>

<style>
  .cscarousel__row {
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: 1fr 3fr;
    align-items: stretch;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .cscarousel__text {
    position: relative;
    display: grid;
  }
  .cscarousel__panel {
    grid-area: 1 / 1;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cscarousel__panel.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .cscarousel__stat,
  .cscarousel__quote {
    background: rgb(35 48 56 / 0.07);
    border-radius: var(--radius-card);
    padding: clamp(1.5rem, 3vw, 2rem);
  }
  .cscarousel__stat {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .cscarousel__stat-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.75rem, 5vw, 3.75rem);
    line-height: 1;
    color: var(--color-orange);
    letter-spacing: -0.01em;
  }
  .cscarousel__stat-label {
    color: var(--color-slate-muted);
    font-size: 1.15rem;
  }
  .cscarousel__quote {
    display: grid;
    align-content: center;
    gap: 1.1rem;
    justify-items: start;
  }
  .cscarousel__body {
    color: var(--color-slate);
    max-width: 42ch;
    line-height: 1.6;
    font-size: 1.2rem;
  }

  .cscarousel__media {
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    aspect-ratio: 16 / 9;
  }
  .cscarousel__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cscarousel__img.is-active {
    opacity: 1;
    position: relative;
  }

  .cscarousel__dots {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .cscarousel__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: rgb(35 48 56 / 0.18);
    cursor: pointer;
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .cscarousel__dot:hover { background: rgb(35 48 56 / 0.32); }
  .cscarousel__dot.is-active {
    background: var(--color-ink);
    transform: scale(1.15);
  }

  @media (prefers-reduced-motion: reduce) {
    .cscarousel__img,
    .cscarousel__panel { transition: none; }
  }

  @media (max-width: 820px) {
    .cscarousel__row { grid-template-columns: 1fr; }
    .cscarousel__text { min-height: 320px; }
    .cscarousel__media { aspect-ratio: 16 / 11; }
  }
</style>
