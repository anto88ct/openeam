---
import Button from "./Button.astro";
import { Image } from "astro:assets";

/** Rounded closing band: photo on one side, heading+body+CTA on the other. `compact` (only meaningful without an image) renders heading+body left / button right in a single row instead of a tall stacked block. */
interface Props {
  heading: string;
  body: string;
  image?: ImageMetadata;
  imageAlt?: string;
  tone?: "teal" | "ink" | "orange" | "sage";
  ctaLabel: string;
  ctaHref: string;
  ctaVariant?: "primary" | "teal" | "dark";
  reverse?: boolean;
  compact?: boolean;
}
const {
  heading,
  body,
  image,
  imageAlt = "",
  tone = "teal",
  ctaLabel,
  ctaHref,
  ctaVariant = "primary",
  reverse = false,
  compact = false,
} = Astro.props;
---

<article
  class:list={[
    "band",
    `band--${tone}`,
    {
      "band--reverse": reverse,
      "band--solo": !image,
      "band--compact": compact && !image,
    },
  ]}
>
  {
    image && (
      <div class="band__media">
        <Image
          src={image}
          alt={imageAlt}
          width={720}
          height={560}
          loading="lazy"
        />
      </div>
    )
  }
  <div class="band__text">
    <div class="band__copy">
      <h2 class="band__title" set:html={heading} />
      <p class="band__body">{body}</p>
    </div>
    {
      ctaLabel && !compact && (
        <Button href={ctaHref} variant={ctaVariant}>
          {ctaLabel}
        </Button>
      )
    }
  </div>
  {
    ctaLabel && compact && (
      <div class="band__cta">
        <Button href={ctaHref} variant={ctaVariant}>
          {ctaLabel}
        </Button>
      </div>
    )
  }
</article>

<style>
  .band {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    min-height: 360px;
  }
  .band--solo {
    grid-template-columns: 1fr;
  }
  .band__media {
    position: relative;
  }
  .band__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .band__text {
    padding: clamp(2rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.4rem;
    align-items: flex-start;
  }
  .band__copy {
    display: grid;
    gap: 0.6rem;
  }
  .band__title {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    color: #fff;
    max-width: 20ch;
  }
  .band__body {
    color: rgb(255 255 255 / 0.9);
    max-width: 46ch;
    font-size: 1.05rem;
  }

  .band--teal {
    background: var(--color-teal);
  }
  .band--ink {
    background: var(--color-ink);
  }
  .band--orange {
    background: var(--color-orange);
  }
  .band--sage {
    background: #d3ddde;
  }
  .band--sage .band__title {
    color: var(--color-ink);
  }
  .band--sage .band__body {
    color: var(--color-slate);
  }

  .band--reverse .band__media {
    order: 2;
  }

  .band--compact {
    position: relative;
    overflow: visible;
    min-height: unset;
  }
  .band--compact .band__text {
    display: block;
    padding: clamp(1.5rem, 4vw, 4rem) clamp(2rem, 4vw, 3rem);
    padding-right: clamp(12rem, 24vw, 16rem);
  }
  .band--compact .band__copy {
    gap: 0.4rem;
    max-width: 50rem;
  }
  .band--compact .band__title {
    max-width: none;
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
  }
  .band--compact .band__body {
    max-width: 80ch;
    font-size: 1rem;
  }
  .band--compact .band__cta {
    position: absolute;
    right: clamp(0rem, 0vw, 3rem);
    bottom: -1.5rem;
    border-radius: var(--radius-card);
    padding: 2rem 1.25rem;
  }

  .band__cta > a {
    width: min(300px, 100%);
    height: 70px;
    font-size: 1.25rem;
  }

  @media (max-width: 820px) {
    .band {
      grid-template-columns: 1fr;
    }
    .band--reverse .band__media {
      order: 0;
    }
    .band__media {
      min-height: 240px;
    }
    .band--compact {
      overflow: hidden;
    }
    .band--compact .band__text {
      padding-right: clamp(1.5rem, 3vw, 2rem);
      padding-bottom: 5rem;
    }
    .band--compact .band__cta {
      position: static;
      margin: 0 clamp(1.5rem, 3vw, 2rem) clamp(1.5rem, 3vw, 2rem);
      display: inline-block;
    }
  }
</style>
