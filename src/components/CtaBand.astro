---
import Button from './Button.astro';
import { Image } from 'astro:assets';

/** Rounded closing band: photo on one side, heading+body+CTA on the other. */
interface Props {
  heading: string;
  body: string;
  image?: ImageMetadata;
  imageAlt?: string;
  tone?: 'teal' | 'ink' | 'orange' | 'sage';
  ctaLabel: string;
  ctaHref: string;
  ctaVariant?: 'primary' | 'teal' | 'dark';
  reverse?: boolean;
}
const {
  heading,
  body,
  image,
  imageAlt = '',
  tone = 'teal',
  ctaLabel,
  ctaHref,
  ctaVariant = 'primary',
  reverse = false,
} = Astro.props;
---
<article class:list={['band', `band--${tone}`, { 'band--reverse': reverse, 'band--solo': !image }]}>
  {image && (
    <div class="band__media">
      <Image src={image} alt={imageAlt} width={720} height={560} loading="lazy" />
    </div>
  )}
  <div class="band__text">
    <h2 class="band__title" set:html={heading} />
    <p class="band__body">{body}</p>
    {ctaLabel && <Button href={ctaHref} variant={ctaVariant}>{ctaLabel}</Button>}
  </div>
</article>

<style>
  .band {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    min-height: 360px;
  }
  .band--solo { grid-template-columns: 1fr; }
  .band__media { position: relative; }
  .band__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .band__text {
    padding: clamp(2rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.4rem;
    align-items: flex-start;
  }
  .band__title { font-size: clamp(1.6rem, 3vw, 2.3rem); color: #fff; max-width: 20ch; }
  .band__body { color: rgb(255 255 255 / 0.9); max-width: 46ch; font-size: 1.05rem; }

  .band--teal { background: var(--color-teal); }
  .band--ink { background: var(--color-ink); }
  .band--orange { background: var(--color-orange); }
  .band--sage { background: #d3ddde; }
  .band--sage .band__title { color: var(--color-ink); }
  .band--sage .band__body { color: var(--color-slate); }

  .band--reverse .band__media { order: 2; }

  @media (max-width: 820px) {
    .band { grid-template-columns: 1fr; }
    .band--reverse .band__media { order: 0; }
    .band__media { min-height: 240px; }
  }
</style>
