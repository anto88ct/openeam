---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import DottedGridFX from './DottedGridFX.astro';
import logoSvg from '../assets/img/smau/smau-x-seedma.svg?raw';
import duomo from '../assets/img/smau/duomo.jpeg';

/** Event banner: Seedma at SMAU Milano. White band, SMAU-red interactive dots, animated logo card. */
interface Props {
  heading: string;
  sub: string;
  sub2: string;
  monthLabel: string;
  weekdays: readonly string[];
  dateAria: string;
  ctaLabel: string;
  ctaHref: string;
  logoAlt: string;
}
const {
  heading,
  sub,
  sub2,
  monthLabel,
  weekdays,
  dateAria,
  ctaLabel,
  ctaHref,
  logoAlt,
} = Astro.props;

// November 2026 starts on a Sunday; week runs Monday to Sunday.
const MONTH_OFFSET = 6;
const DAYS_IN_MONTH = 30;
const EVENT_DAYS = [3, 4];
const PREV_MONTH_LAST = 31;
const cells: { n: number; out: boolean }[] = [
  ...Array.from({ length: MONTH_OFFSET }, (_, i) => ({ n: PREV_MONTH_LAST - MONTH_OFFSET + 1 + i, out: true })),
  ...Array.from({ length: DAYS_IN_MONTH }, (_, i) => ({ n: i + 1, out: false })),
];
const trail = (7 - (cells.length % 7)) % 7;
for (let i = 1; i <= trail; i++) cells.push({ n: i, out: true });
const [monthName, ...yearParts] = monthLabel.split(' ');
const year = yearParts.join(' ');

const headingHtml = heading.replace(/SMAU Milano/, '<span class="smau__hl">SMAU Milano</span>');

// Inline the SVG so its parts can be animated; drop the fixed 100% box so CSS sizes it.
const logoInline = logoSvg
  .replace(/<svg([^>]*?)\swidth="100%"\s+height="100%"/, '<svg$1')
  .replace(/<svg /, '<svg role="img" aria-label="' + logoAlt.replace(/"/g, '&quot;') + '" ');
---
<section class="smau-band" id="smau">
  <DottedGridFX
    rgb="237 28 36"
    accent="237 28 36"
    opacity={0.28}
    opacityHover={1}
    size={1.5}
    scale={2.6}
  />
  <Image class="smau__duomo" src={duomo} alt="" aria-hidden="true" width={900} format="webp" quality={70} loading="lazy" decoding="async" />
  <div class="container-page smau-band__inner">
    <div class="smau">
      <div class="smau__text">
        <h2 class="smau__title" set:html={headingHtml} />
        <div class="smau__subs">
          <p class="smau__sub">{sub}</p>
          <p class="smau__sub smau__sub--more">{sub2}</p>
        </div>

        <div class="smau__meta">
          <div class="smau__cal" data-smau-anim role="img" aria-label={dateAria}>
            <span class="smau__cal-binder smau__cal-binder--l" aria-hidden="true"></span>
            <span class="smau__cal-binder smau__cal-binder--r" aria-hidden="true"></span>
            <div class="smau__cal-head" aria-hidden="true">
              <span class="smau__cal-month">{monthName}</span>
              <span class="smau__cal-year">{year}</span>
            </div>
            <div class="smau__cal-grid" aria-hidden="true">
              {weekdays.map((d, i) => <span class:list={['smau__cal-wd', { 'smau__cal-we': i >= 5 }]}>{d}</span>)}
              {cells.map(({ n, out }, i) => (
                <span
                  class:list={[
                    'smau__cal-day',
                    {
                      'smau__cal-day--out': out,
                      'smau__cal-we': i % 7 >= 5,
                      'smau__cal-day--event': !out && EVENT_DAYS.includes(n),
                      'smau__cal-day--first': !out && n === EVENT_DAYS[0],
                      'smau__cal-day--last': !out && n === EVENT_DAYS[EVENT_DAYS.length - 1],
                    },
                  ]}
                  style={`--i:${i}`}
                >{n}</span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="smau__art">
        <div class="smau__ticket">
          <div class="smau__card" data-smau-card data-smau-anim set:html={logoInline} />
        </div>
        <div class="smau__cta">
          <Button href={ctaHref} variant="primary" target="_blank" rel="noopener">{ctaLabel}</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .smau-band {
    position: relative;
    overflow: hidden;
    background: #fff;
    --smau-pad: 7.5rem;
    scroll-margin-top: 70px;
  }
  @media (max-width: 768px) {
    .smau-band { --smau-pad: 1.5rem; }
  }
  /* Static texture until the canvas takes over (no JS, touch, reduced motion) */
  .smau-band:not([data-dotfx-live]) {
    background-image: radial-gradient(rgb(237 28 36 / 0.28) 1.5px, transparent 1.9px);
    background-size: 30px 30px;
    background-color: #fff;
  }
  .smau-band__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.5rem, 4.5vw, 4.5rem);
  }

  .smau {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .smau__text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    justify-items: start;
  }
  .smau__title {
    color: var(--color-ink);
    font-size: clamp(2rem, 4.4vw, 3.5rem);
    line-height: 1.1;
    text-wrap: balance;
    max-width: 20ch;
  }
  .smau__sub {
    color: var(--color-slate);
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    line-height: 1.55;
    max-width: 30rem;
  }
  .smau__subs { display: grid; gap: 0.5rem; }
  .smau__sub--more { font-size: clamp(1rem, 1.3vw, 1.1rem); }

  .smau__meta {
    justify-self: stretch;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1.25rem;
  }
  /* Calendar: November 2026 as a desk calendar, event days marked in SMAU red */
  .smau__cal {
    position: relative;
    width: 28rem;
    max-width: 100%;
    margin-top: 0.6rem;
    background: #fff;
    border-radius: 22px;
    box-shadow:
      0 1px 0 rgb(255 255 255) inset,
      0 36px 60px -30px rgb(35 48 56 / 0.45),
      0 0 0 1px rgb(35 48 56 / 0.08);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s;
  }
  .smau__cal:hover { transform: translateY(-4px); }
  .smau__cal-binder {
    position: absolute;
    top: -0.65rem;
    z-index: 2;
    width: 0.6rem;
    height: 1.5rem;
    border-radius: 999px;
    background: linear-gradient(90deg, #cfd4d8, #fff 45%, #aeb5ba);
    box-shadow: 0 2px 4px rgb(35 48 56 / 0.3);
  }
  .smau__cal-binder--l { left: 18%; }
  .smau__cal-binder--r { right: 18%; }
  .smau__cal-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 1.35rem 1.4rem 1rem;
    border-radius: 22px 22px 0 0;
    background:
      radial-gradient(120% 140% at 0% 0%, rgb(255 255 255 / 0.18), transparent 55%),
      #ed1c24;
    color: #fff;
  }
  .smau__cal-month {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.7rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .smau__cal-year {
    font-weight: 600;
    font-size: 1.15rem;
    opacity: 0.85;
    font-variant-numeric: tabular-nums;
  }
  .smau__cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    row-gap: 0.3rem;
    padding: 1rem 1rem 1.1rem;
    text-align: center;
  }
  .smau__cal-wd {
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-slate-muted);
    padding-bottom: 0.55rem;
    margin-bottom: 0.2rem;
    border-bottom: 1px solid rgb(35 48 56 / 0.1);
  }
  .smau__cal-wd:nth-child(-n + 7) { border-bottom: 1px solid rgb(35 48 56 / 0.1); }
  .smau__cal-day {
    position: relative;
    display: grid;
    place-items: center;
    height: 2.35rem;
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .smau__cal-we { color: var(--color-slate-muted); }
  .smau__cal-day--out { color: rgb(90 111 121 / 0.4); font-weight: 500; }
  .smau__cal-day--event {
    z-index: 0;
    color: #fff;
    font-weight: 800;
    font-size: 1.05rem;
  }
  .smau__cal-day--event::before {
    content: '';
    position: absolute;
    inset: 0.05rem 0;
    z-index: -1;
    background: linear-gradient(135deg, #f23a41, #d9141b);
    box-shadow: 0 10px 18px -8px rgb(237 28 36 / 0.75);
  }
  .smau__cal-day--first::before { border-radius: 999px 0 0 999px; inset-inline-start: 0.1rem; }
  .smau__cal-day--last::before { border-radius: 0 999px 999px 0; inset-inline-end: 0.1rem; }
  .smau__title :global(.smau__hl) { color: var(--color-orange); }

  .smau__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(1.5rem, 2.5vw, 2.25rem);
  }

  /* Logo card: the SVG carries its own white plate */
  .smau__art { position: relative; perspective: 1200px; }
  /* Duomo di Milano photo: mirrored, multiplied into the white band, base on the section's bottom edge, flush with the right edge */
  .smau__duomo {
    position: absolute;
    bottom: 0;
    right: 0;
    height: min(100%, 52rem);
    width: auto;
    max-width: 50%;
    object-fit: contain;
    object-position: right bottom;
    transform: scaleX(-1);
    mix-blend-mode: multiply;
    opacity: 0.28;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  /* Ticket: straight, notched at the perforation line (60.6% down), soft shadow on the wrapper */
  .smau__ticket {
    position: relative;
    z-index: 1;
    filter:
      drop-shadow(0 1px 1px rgb(35 48 56 / 0.1))
      drop-shadow(0 28px 34px rgb(35 48 56 / 0.2));
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .smau__ticket:hover { transform: translateY(-6px); }
  .smau__card {
    border-radius: 24px;
    background: #fff;
    -webkit-mask:
      radial-gradient(circle 15px at 0 60.6%, #0000 97%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle 15px at 100% 60.6%, #0000 97%, #000) right / 51% 100% no-repeat;
    mask:
      radial-gradient(circle 15px at 0 60.6%, #0000 97%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle 15px at 100% 60.6%, #0000 97%, #000) right / 51% 100% no-repeat;
  }
  .smau__card :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---- Logo animation ------------------------------------------------------
     Default state is the finished artwork. The script arms the card only when it
     starts out of view, then plays the sequence once it scrolls in. */
  .smau__card :global(.a-smau),
  .smau__card :global(.a-x),
  .smau__card :global(.a-seedma),
  .smau__card :global(.a-line),
  .smau__card :global(.a-info),
  .smau__card :global(.a-accent) {
    transform-box: fill-box;
    transform-origin: center;
  }
  .smau__card :global(.a-line) { transform-origin: left center; }

  .smau__card[data-armed]:not([data-play]) :global(.a-smau),
  .smau__card[data-armed]:not([data-play]) :global(.a-x),
  .smau__card[data-armed]:not([data-play]) :global(.a-seedma),
  .smau__card[data-armed]:not([data-play]) :global(.a-line),
  .smau__card[data-armed]:not([data-play]) :global(.a-info),
  .smau__card[data-armed]:not([data-play]) :global(.a-accent) { opacity: 0; }

  .smau__card[data-play] :global(.a-smau) { animation: smau-pop 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both; }
  .smau__card[data-play] :global(.a-x) { animation: smau-spin 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.55s both; }
  .smau__card[data-play] :global(.a-seedma) { animation: smau-pop 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.75s both; }
  .smau__card[data-play] :global(.a-line) { animation: smau-draw 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.1s both; }
  .smau__card[data-play] :global(.a-info) { animation: smau-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) 1.35s both; }
  .smau__card[data-play] :global(.a-accent) {
    animation:
      smau-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) 1.6s both,
      smau-beat 3s ease-in-out 2.6s infinite;
  }

  @keyframes smau-pop {
    from { opacity: 0; transform: translateY(18px) scale(0.92); }
    to { opacity: 1; transform: none; }
  }
  @keyframes smau-spin {
    from { opacity: 0; transform: rotate(-120deg) scale(0.2); }
    to { opacity: 1; transform: none; }
  }
  @keyframes smau-draw {
    from { opacity: 1; transform: scaleX(0); }
    to { opacity: 1; transform: scaleX(1); }
  }
  @keyframes smau-fade-up {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes smau-beat {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.04); }
  }

  /* Calendar: days fade in row by row, then the event days fill in */
  .smau__cal[data-armed]:not([data-play]) .smau__cal-day { opacity: 0; }
  .smau__cal[data-armed]:not([data-play]) .smau__cal-day--event::before { transform: scaleX(0); }

  .smau__cal[data-play] .smau__cal-day {
    animation: smau-fade-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) calc(0.2s + var(--i) * 0.025s) both;
  }
  .smau__cal[data-play] .smau__cal-day--event::before {
    transform-origin: left center;
    animation: smau-draw 0.7s cubic-bezier(0.16, 1, 0.3, 1) 1.2s both;
  }

  /* Scroll-driven entrance for the text column */
  @supports (animation-timeline: view()) {
    .smau__text > * {
      animation: smau-rise linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 55%;
    }
    .smau__text > :nth-child(2) { animation-range: entry 5% entry 60%; }
    .smau__text > :nth-child(3) { animation-range: entry 10% entry 65%; }
    .smau__text > :nth-child(4) { animation-range: entry 15% entry 70%; }
    .smau__text > :nth-child(5) { animation-range: entry 20% entry 75%; }
  }
  @keyframes smau-rise {
    from { transform: translateY(28px); }
    to { transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .smau__text > *,
    .smau__card :global(*),
    .smau__cal *,
    .smau__cal *::before { animation: none !important; }
    .smau__card[data-armed] :global(*),
    .smau__cal[data-armed] * { opacity: 1 !important; transform: none !important; }
    .smau__ticket:hover { transform: none; }
  }

  @media (max-width: 1100px) {
    .smau {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .smau__text,
    .smau__art { min-width: 0; }
    .smau__title { max-width: none; font-size: clamp(1.9rem, 7.5vw, 2.6rem); }
    .smau__duomo { opacity: 0.07; }
  }
  @media (max-width: 480px) {
    .smau-band__inner { padding-block: 2.25rem 2.75rem; }
    .smau__cal-head { padding: 1.15rem 1.1rem 0.85rem; }
    .smau__cal-month { font-size: 1.45rem; }
    .smau__cal-grid { padding: 0.85rem 0.6rem 0.9rem; }
    .smau__cal-day { height: 2.15rem; font-size: 0.95rem; }
    .smau__ticket { margin-inline: -0.25rem; }
  }
</style>

<script>
  // Images above the band settle after the browser's own anchor jump; re-aim once everything has loaded.
  if (location.hash === '#smau') {
    window.addEventListener('load', () => document.getElementById('smau')?.scrollIntoView());
  }

  const targets = document.querySelectorAll<HTMLElement>('[data-smau-anim]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (targets.length && !calm && 'IntersectionObserver' in window) {
    targets.forEach((el) => {
      const rect = el.getBoundingClientRect();
      const inView = rect.top < window.innerHeight * 0.9 && rect.bottom > 0;
      if (inView) {
        el.dataset.play = '';
        return;
      }
      el.dataset.armed = '';
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            el.dataset.play = '';
            io.disconnect();
          }
        },
        { threshold: 0.35 },
      );
      io.observe(el);
    });
  }
</script>
