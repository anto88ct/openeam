---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { platformLinks, industryLinks } from '../config/site';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = (href: string) => getLocalizedPath(lang, href);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = l(href);
  return href === '/' ? path === target : path === target || path.startsWith(target + '/');
};
const groupActive = (links: { href: string }[]) => links.some((link) => isActive(link.href));
---
<header class="nav" data-nav>
  <div class="container-page nav__inner">
    <Logo tone="dark" href={l('/')} />

    <button
      class="nav__burger"
      data-nav-toggle
      aria-label={t('burgerAriaLabel')}
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="nav__burger-line"></span>
      <span class="nav__burger-line"></span>
      <span class="nav__burger-line"></span>
    </button>

    <div class="nav__scrim" data-nav-scrim></div>

    <nav id="nav-menu" class="nav__menu" data-nav-menu aria-label={t('navAriaLabel')}>
      <span class="nav__eyebrow" aria-hidden="true">Menu</span>

      <a href={l('/')} class:list={['nav__link', { 'is-active': isActive('/') }]}>Home</a>
      <a href={l('/azienda')} class:list={['nav__link', { 'is-active': isActive('/azienda') }]}>Azienda</a>

      <div class="nav__item" data-dropdown>
        <button
          class:list={['nav__link nav__trigger', { 'is-active': groupActive(platformLinks) }]}
          aria-expanded="false"
        >
          Platform
          <svg width="12" height="8" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
        </button>
        <div class="nav__panel nav__panel--mega">
          {platformLinks.map((link) => (
            <a href={l(link.href)} class="nav__mega-link">
              <span class="nav__arrow">→</span>{link.label}
            </a>
          ))}
        </div>
      </div>

      <div class="nav__item" data-dropdown>
        <button
          class:list={['nav__link nav__trigger', { 'is-active': groupActive(industryLinks) }]}
          aria-expanded="false"
        >
          By Industry
          <svg width="12" height="8" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
        </button>
        <div class="nav__panel">
          {industryLinks.map((link) => (
            <a href={l(link.href)} class="nav__mega-link">
              <span class="nav__arrow">→</span>{link.label}
            </a>
          ))}
        </div>
      </div>

      <a href={l('/pricing')} class:list={['nav__link', { 'is-active': isActive('/pricing') }]}>Pricing</a>

      <div class="nav__lang-row">
        <LangSwitch lang={lang} />
      </div>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid rgb(35 48 56 / 0.07);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 70px;
  }
  .nav__inner :global(.logo) {
    border-radius: 12px;
    padding: 0.4rem 0.6rem;
    margin: -0.4rem -0.6rem;
    box-shadow: 0 0 0 0 rgb(255 91 4 / 0);
    transition: box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav__inner :global(.logo:hover) {
    box-shadow: 0 14px 32px -12px rgb(255 91 4 / 0.35);
  }
  .nav__inner :global(.logo__mark) {
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav__inner :global(.logo:hover .logo__mark) {
    transform: scale(1.05);
  }
  .nav__menu {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav__eyebrow { display: none; }
  .nav__lang-row { display: contents; }
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1.05rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-ink);
    background: none;
    border: 0;
    cursor: pointer;
    border-radius: 10px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .nav__link:hover { color: var(--color-orange); }
  .nav__link.is-active { color: var(--color-orange); }
  .nav__trigger svg { transition: transform 0.2s ease; }

  .nav__item { position: relative; }
  .nav__panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 260px;
    background: #fff;
    border-radius: 16px;
    box-shadow: var(--shadow-card);
    border: 1px solid rgb(35 48 56 / 0.06);
    padding: 0.5rem;
    display: grid;
    gap: 0.15rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
  }
  .nav__item:hover .nav__panel,
  .nav__item:focus-within .nav__panel,
  .nav__panel.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav__item:hover .nav__trigger svg,
  .nav__item:focus-within .nav__trigger svg { transform: rotate(180deg); }

  .nav__mega-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 0.8rem;
    border-radius: 10px;
    font-weight: 600;
    color: var(--color-ink);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .nav__mega-link:hover { background: var(--color-bg); color: var(--color-orange); }
  .nav__arrow { color: var(--color-orange); font-weight: 700; }

  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: 0;
    border-radius: 10px;
    cursor: pointer;
    padding: 8px;
    z-index: 52;
  }
  .nav__burger-line {
    width: 24px;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
    transform-origin: center;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease;
  }
  .nav[data-open] .nav__burger-line:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav[data-open] .nav__burger-line:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .nav[data-open] .nav__burger-line:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav__scrim { display: none; }

  @media (max-width: 900px) {
    .nav__inner { padding-inline: 1.25rem; }
    .nav__burger { display: flex; margin-right: -8px; }
    .nav__inner :global(.logo) { margin-left: -0.6rem; }

    .nav__scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 46;
      background: rgb(35 48 56 / 0.45);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.25s ease, visibility 0.25s;
    }
    .nav[data-open] .nav__scrim { opacity: 1; visibility: visible; pointer-events: auto; }

    .nav__menu {
      position: fixed;
      inset: 0 0 0 auto;
      z-index: 47;
      width: min(85vw, 380px);
      flex-direction: column;
      align-items: stretch;
      gap: 0.2rem;
      background: #fff;
      padding: 88px 1.25rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
      box-shadow: -18px 0 40px -20px rgb(35 48 56 / 0.35);
      transform: translateX(100%);
      transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
      overflow-y: auto;
    }
    .nav[data-open] .nav__menu { transform: translateX(0); }

    .nav__eyebrow {
      display: block;
      font-family: var(--font-sans);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-slate-muted);
      padding: 0 1.05rem 0.6rem;
    }

    .nav__link {
      width: 100%;
      justify-content: space-between;
      padding: 0.85rem 1.05rem;
      border-radius: 12px;
      border-left: 3px solid transparent;
    }
    .nav__link.is-active {
      background: rgb(255 91 4 / 0.08);
      border-left-color: var(--color-orange);
    }
    .nav__item + a.nav__link,
    .nav__item { border-top: 1px solid rgb(35 48 56 / 0.06); }
    a.nav__link:first-of-type { border-top: 0; }

    .nav__panel {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: 0;
      background: transparent;
      padding: 0.1rem 0 0.6rem 1.3rem;
      margin-left: 0.55rem;
      border-left: 2px solid rgb(35 48 56 / 0.08);
      display: none;
    }
    .nav__panel.is-open { display: grid; }
    .nav__mega-link { padding: 0.55rem 0.7rem; }

    .nav__lang-row {
      display: block;
      margin-top: 0.75rem;
      padding-top: 0.9rem;
      border-top: 1px solid rgb(35 48 56 / 0.08);
    }
    .nav__lang-row :global(.lang-switch) {
      width: 100%;
      justify-content: stretch;
      background: var(--color-bg);
    }
    .nav__lang-row :global(.lang-switch__flag) {
      flex: 1;
      justify-content: center;
      padding: 0.6rem;
    }

    @media (prefers-reduced-motion: no-preference) {
      .nav__menu > * {
        opacity: 0;
        transform: translateX(12px);
      }
      .nav[data-open] .nav__menu > * {
        animation: nav-item-in 0.32s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }
      .nav[data-open] .nav__menu > *:nth-child(1) { animation-delay: 0.05s; }
      .nav[data-open] .nav__menu > *:nth-child(2) { animation-delay: 0.09s; }
      .nav[data-open] .nav__menu > *:nth-child(3) { animation-delay: 0.13s; }
      .nav[data-open] .nav__menu > *:nth-child(4) { animation-delay: 0.17s; }
      .nav[data-open] .nav__menu > *:nth-child(5) { animation-delay: 0.21s; }
      .nav[data-open] .nav__menu > *:nth-child(6) { animation-delay: 0.25s; }
      @keyframes nav-item-in {
        to { opacity: 1; transform: translateX(0); }
      }
    }
  }
</style>

<script>
  const header = document.querySelector('[data-nav]');
  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.querySelector('[data-nav-menu]');
  const scrim = document.querySelector('[data-nav-scrim]');
  const mq = window.matchMedia('(max-width: 900px)');

  function setOpen(open: boolean) {
    header?.toggleAttribute('data-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open && mq.matches ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setOpen(!header?.hasAttribute('data-open')));
  scrim?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  menu?.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('a.nav__link, a.nav__mega-link');
    if (target && mq.matches) setOpen(false);
  });
  mq.addEventListener('change', (e) => {
    if (!e.matches) setOpen(false);
  });

  // Mobile: tap a dropdown trigger to expand its panel in place.
  document.querySelectorAll('[data-dropdown]').forEach((item) => {
    const trigger = item.querySelector('.nav__trigger');
    const panel = item.querySelector('.nav__panel');
    trigger?.addEventListener('click', (e) => {
      if (!mq.matches) return; // desktop uses hover
      e.preventDefault();
      const open = panel?.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(!!open));
    });
  });
</script>
