---
import Button from './Button.astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  body: string;
  href: string;
  image?: ImageMetadata;
  imageAlt?: string;
  ctaLabel?: string;
}
const { title, body, href, image, imageAlt = '', ctaLabel = 'Scopri di più' } = Astro.props;
---
<article class="csc">
  {image && (
    <a href={href} class="csc__media" tabindex="-1" aria-hidden="true">
      <Image src={image} alt={imageAlt} width={640} height={420} loading="lazy" />
    </a>
  )}
  <div class="csc__body">
    <h3 class="csc__title"><a href={href}>{title}</a></h3>
    <p class="csc__text">{body}</p>
    <Button href={href} variant="primary" class="csc__cta">{ctaLabel}</Button>
  </div>
</article>

<style>
  .csc {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    height: 100%;
  }
  .csc__media { display: block; aspect-ratio: 16 / 10; overflow: hidden; }
  .csc__media :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.4s ease;
  }
  .csc:hover .csc__media :global(img) { transform: scale(1.04); }
  .csc__body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-items: flex-start;
    flex: 1;
  }
  .csc__title { font-size: 1.35rem; color: var(--color-ink); }
  .csc__title a:hover { color: var(--color-orange); }
  .csc__text { color: var(--color-slate); font-size: 0.98rem; flex: 1; }
</style>
