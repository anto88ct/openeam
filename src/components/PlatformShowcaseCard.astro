---
import { Image } from 'astro:assets';
import Button from './Button.astro';

/** Photo card with a teal arc accent and a frosted glass panel overlapping the bottom, holding icon/heading/tagline/body/CTA. */
interface Props {
  icon: ImageMetadata;
  iconName: "gear" | "wrench" | "document" | "chart";
  image: ImageMetadata;
  imageAlt: string;
  heading: string;
  tagline: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
}
const { icon, iconName, image, imageAlt, heading, tagline, body, ctaLabel, ctaHref } = Astro.props;
---

<article class="psc">
  <div class="psc__media">
    <Image src={image} alt={imageAlt} width={1280} height={1040} loading="lazy" />
    <div class="psc__arc" aria-hidden="true"></div>
  </div>
  <div class="psc__panel">
    <div class="psc__head">
      <span class={`psc__icon psc__icon--${iconName}`}><Image src={icon} alt="" width={28} height={28} /></span>
      <h3 class="psc__heading">{heading}</h3>
    </div>
    <p class="psc__tagline">{tagline}</p>
    <p class="psc__body">{body}</p>
    <Button href={ctaHref} variant="primary">{ctaLabel}</Button>
  </div>
</article>

<style>
  .psc {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    background: #fff;
    max-width: 1280px;
    margin-inline: auto;
  }
  .psc__media {
    position: relative;
    aspect-ratio: 4 / 3.1;
    overflow: hidden;
  }
  .psc__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* .psc__arc {
    position: absolute;
    z-index: 1;
    width: 68%;
    aspect-ratio: 1;
    left: -16%;
    bottom: -28%;
    background: var(--color-teal);
    border-radius: 50%;
    opacity: 0.9;
  } */
  .psc__panel {
    position: relative;
    z-index: 2;
    margin-top: -34%;
    background: rgb(255 255 255 / 0.78);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-radius: 20px 20px 0 0;
    padding: clamp(1.15rem, 2.2vw, 1.5rem) clamp(1.15rem, 2.2vw, 1.4rem) clamp(1.25rem, 2.2vw, 1.5rem);
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.4rem;
    flex: 1;
  }
  .psc__head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .psc__icon :global(img) {
    width: 26px;
    height: 26px;
    object-fit: contain;
    transform-origin: center;
    transition: transform 0.25s ease-out;
  }

  @media (prefers-reduced-motion: no-preference) {
    .psc:hover .psc__icon--gear :global(img) {
      animation: psc-spin 1.1s linear infinite;
    }
    .psc:hover .psc__icon--wrench :global(img) {
      animation: psc-wiggle 0.5s ease-in-out infinite;
    }
    .psc:hover .psc__icon--document :global(img) {
      transform: translateY(-3px) rotate(3deg);
    }
    .psc:hover .psc__icon--chart :global(img) {
      transform: scale(1.12) translateY(-2px);
    }
  }

  @keyframes psc-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes psc-wiggle {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-15deg); }
    75% { transform: rotate(15deg); }
  }
  .psc__heading { font-size: clamp(1.1rem, 1.7vw, 1.3rem); color: var(--color-ink); }
  .psc__tagline {
    color: var(--color-ink);
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .psc__body {
    color: var(--color-slate-muted);
    font-size: 0.92rem;
    line-height: 1.45;
    margin-top: 0.2rem;
  }
  .psc__panel :global(.btn) { margin-top: auto; padding-top: 0.3rem; }

  @media (max-width: 480px) {
    .psc__media { aspect-ratio: 16 / 11; }
    .psc__panel { margin-top: -22%; }
  }
</style>
