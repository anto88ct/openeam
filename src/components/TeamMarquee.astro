---
import { Image } from 'astro:assets';

/** Infinite horizontal auto-scroll of team member cards. Content is duplicated once for a seamless loop; the duplicate is hidden and the scroll disabled under prefers-reduced-motion, falling back to a manually scrollable row. */
interface Member {
  photo: ImageMetadata;
  name: string;
  role: string;
  /** shrink an individual photo when its source crop reads larger/tighter than the rest */
  scale?: number;
  linkedin?: string;
}
interface Props {
  members: Member[];
}
const { members } = Astro.props;
const speedSeconds = members.length * 6;
---

<div class="tm-bleed">
  <div class="tm-track" style={`animation-duration: ${speedSeconds}s`}>
    {
      [0, 1].map((setIndex) => (
        <div class="tm-set" aria-hidden={setIndex === 1 ? 'true' : undefined}>
          {members.map((m) => (
            <article class="tm-card">
              <div class="tm-avatar-wrap">
                <div class="tm-avatar">
                  <Image
                    src={m.photo}
                    alt={m.name}
                    width={320}
                    height={320}
                    loading="lazy"
                    style={m.scale ? `transform: scale(${m.scale})` : undefined}
                  />
                </div>
                {m.linkedin && (
                  <a
                    class="tm-linkedin"
                    href={m.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${m.name} — LinkedIn`}
                  >
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.07-.926-2.07-2.07 0-1.143.926-2.069 2.07-2.069 1.143 0 2.069.926 2.069 2.07 0 1.143-.926 2.069-2.069 2.069zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                  </a>
                )}
              </div>
              <p class="tm-name">{m.name}</p>
              <p class="tm-role">{m.role}</p>
            </article>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .tm-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    overflow: hidden;
  }
  .tm-track {
    display: flex;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    width: max-content;
    padding-inline: 5.5rem;
    animation-name: tm-scroll;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  .tm-bleed:hover .tm-track {
    animation-play-state: paused;
  }
  .tm-set {
    display: flex;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .tm-card {
    flex: 0 0 260px;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.4rem;
  }
  .tm-avatar-wrap {
    position: relative;
    margin-bottom: 0.5rem;
  }
  .tm-avatar {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow-soft);
  }
  .tm-avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .tm-linkedin {
    position: absolute;
    right: 6px;
    bottom: 6px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #0a66c2;
    color: #fff;
    box-shadow: var(--shadow-soft);
    border: 3px solid #fff;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .tm-linkedin svg { width: 20px; height: 20px; }
  .tm-linkedin:hover {
    background: #084d95;
    transform: scale(1.08);
  }
  .tm-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .tm-role {
    color: var(--color-slate-muted);
    font-size: 0.9rem;
    line-height: 1.45;
    max-width: 22ch;
  }

  @keyframes tm-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tm-bleed { overflow-x: auto; }
    .tm-track { animation: none; }
    .tm-set:last-child { display: none; }
  }
</style>
