---
import Button from './Button.astro';
import { Image } from 'astro:assets';
import statementBg from '../assets/img/azienda/bg.png';

/** Dark CTA band with the same decorative background image Azienda.astro's statement section uses. */
interface Props {
  heading: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
}
const { heading, body, ctaLabel, ctaHref } = Astro.props;
---

<section class="blob-cta">
  <Image src={statementBg} alt="" class="blob-cta__bg" aria-hidden="true" />
  <div class="container-page blob-cta__content">
    <h2 class="blob-cta__heading">{heading}</h2>
    <p class="blob-cta__body">{body}</p>
    <Button href={ctaHref} variant="primary">{ctaLabel}</Button>
  </div>
</section>

<style>
  .blob-cta {
    position: relative;
    overflow: hidden;
    background: var(--color-ink);
    text-align: center;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }
  .blob-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    z-index: 0;
  }
  .blob-cta__content {
    position: relative;
    z-index: 1;
    max-width: 50rem;
    margin-inline: auto;
    display: grid;
    gap: 1.4rem;
    justify-items: center;
  }
  .blob-cta__heading { color: #fff; font-size: clamp(1.7rem, 3.4vw, 2.6rem); }
  .blob-cta__body { color: rgb(255 255 255 / 0.9); font-size: 1.1rem; line-height: 1.7; }
</style>
