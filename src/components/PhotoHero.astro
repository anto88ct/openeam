---
import Button from './Button.astro';
import { Image } from 'astro:assets';

/** Full-bleed photo hero with dark overlay + centred heading/sub/CTA. */
interface Props {
  image: ImageMetadata;
  heading: string;
  sub?: string;
  ctaLabel?: string;
  ctaHref?: string;
  overlay?: 'ink' | 'teal';
}
const {
  image,
  heading,
  sub,
  ctaLabel = 'Richiedi una demo',
  ctaHref = '/demo',
  overlay = 'ink',
} = Astro.props;
---
<section class:list={['fhero', `fhero--${overlay}`]}>
  <Image src={image} alt="" class="fhero__bg" widths={[768, 1280, 1920]} sizes="100vw" />
  <div class="fhero__content container-page">
    <h1 class="fhero__title">{heading}</h1>
    {sub && <p class="fhero__sub">{sub}</p>}
    {ctaLabel && <Button href={ctaHref} variant="primary">{ctaLabel}</Button>}
  </div>
</section>

<style>
  .fhero { position: relative; display: grid; place-items: center; min-height: min(72vh, 620px); }
  .fhero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fhero::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .fhero--ink::after { background: linear-gradient(160deg, rgb(30 36 42 / 0.82), rgb(35 48 56 / 0.6)); }
  .fhero--teal::after { background: linear-gradient(160deg, rgb(7 45 49 / 0.85), rgb(7 80 86 / 0.55)); }
  .fhero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: grid;
    gap: 1.4rem;
    justify-items: center;
    padding-block: 4rem;
  }
  .fhero__title { color: #fff; font-size: clamp(2.4rem, 6vw, 4rem); }
  .fhero__sub { color: rgb(255 255 255 / 0.92); font-size: 1.25rem; max-width: 40ch; }
</style>
