---
/** Accessible accordion built on <details>/<summary>. */
interface Item { q: string; a: string; }
interface Props { items: readonly Item[]; }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item, i) => (
    <details class="faq__item" name="faq" open={i === 0}>
      <summary class="faq__q">
        <span set:html={item.q} />
        <svg class="faq__chevron" width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
          <path d="M1 1.5 8 8.5 15 1.5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </summary>
      <div class="faq__a"><p set:html={item.a} /></div>
    </details>
  ))}
</div>

<style>
  .faq { max-width: 52rem; margin-inline: auto; }
  .faq__item { border-bottom: 1px solid rgb(35 48 56 / 0.12); }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 0.25rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.08rem;
    color: #4a6270;
    transition: color 0.15s ease;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--color-orange); }
  .faq__chevron { flex-shrink: 0; color: var(--color-slate-muted); transition: transform 0.22s ease; }
  .faq__item[open] .faq__q { color: var(--color-ink); font-weight: 600; }
  .faq__item[open] .faq__chevron { transform: rotate(180deg); color: var(--color-orange); }
  .faq__a {
    padding: 0 0.25rem 1.5rem;
    color: var(--color-slate-muted);
    line-height: 1.65;
    max-width: 46rem;
  }
</style>
