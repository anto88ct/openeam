---
import Button from './Button.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cookiePolicyHref = getLocalizedPath(lang, '/cookies-policy');
---
<div id="cookie-banner" class="cookie-banner" hidden>
  <p class="cookie-banner__text">
    {t('cookieBannerText')}
    {' '}
    <a href={cookiePolicyHref} class="cookie-banner__link">{t('cookieBannerLink')}</a>
  </p>
  <Button id="cookie-banner-accept" variant="primary" class="cookie-banner__btn">
    {t('cookieBannerAccept')}
  </Button>
</div>

<style>
  .cookie-banner {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 90;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    max-width: 46rem;
    margin-inline: auto;
    padding: 1rem 1.25rem;
    border-radius: 14px;
    background: var(--color-ink);
    color: #fff;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.2);
  }
  .cookie-banner__text {
    flex: 1 1 20rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.85);
    margin: 0;
  }
  .cookie-banner__link {
    color: #fff;
    text-decoration: underline;
    white-space: nowrap;
  }
  .cookie-banner__btn {
    flex: 0 0 auto;
  }
</style>

<script>
  const STORAGE_KEY = 'cookie_consent';
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-banner-accept');

  if (banner && !localStorage.getItem(STORAGE_KEY)) {
    banner.hidden = false;
  }

  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'accepted');
    if (banner) banner.hidden = true;
  });
</script>
