---
import { Image } from 'astro:assets';
import seedmaLogoSrc from '../assets/img/logos/seedma-marchio.svg';
import {
  company,
  sitemapLinks,
  legalLinks,
} from '../config/site';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = (href: string) => getLocalizedPath(lang, href);
---
<footer class="footer">
  <div class="container-page footer__top">
    <div class="footer__brand">
      <Image class="footer__logo" src={seedmaLogoSrc} alt="Seedma" loading="eager" />
    </div>

    <nav class="footer__col" aria-label="Sitemap">
      <h3 class="footer__col-title">Sitemap</h3>
      <ul>
        {sitemapLinks.map((link) => (
          <li><a href={l(link.href)}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container-page footer__legal">
    <p class="footer__copyright">
      <strong>{company.legal}</strong> — {t('footerCopyright')}
    </p>
    <p class="footer__addr">{company.address}</p>
    <ul class="footer__policies">
      {legalLinks.map((link) => (
        <li><a href={l(link.href)}>{link.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: #fff;
    border-top: 1px solid rgb(35 48 56 / 0.08);
    padding-top: 3.5rem;
  }
  .footer__top {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    justify-content: space-between;
    padding-bottom: 2.5rem;
  }
  .footer__brand { max-width: 22rem; }
  .footer__logo {
    height: 2.6rem;
    width: auto;
    display: block;
  }
  .footer__col-title {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: 0.9rem;
  }
  .footer__col ul { list-style: none; display: grid; gap: 0.55rem; }
  .footer__col a {
    color: var(--color-slate-muted);
    font-size: 0.95rem;
    transition: color 0.15s ease;
  }
  .footer__col a:hover { color: var(--color-orange); }

  .footer__legal {
    border-top: 1px solid rgb(35 48 56 / 0.08);
    padding: 1.5rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    color: var(--color-slate-muted);
  }
  .footer__legal strong { color: var(--color-ink); }
  .footer__addr { opacity: 0.85; }
  .footer__policies { list-style: none; display: flex; gap: 1.5rem; }
  .footer__policies a { text-decoration: underline; }
  .footer__policies a:hover { color: var(--color-orange); }
</style>
