---
import { Image } from 'astro:assets';

/** Photo card with a teal arc accent and a frosted panel overlapping the bottom, holding heading + body only (no icon/CTA — trimmed sibling of PlatformShowcaseCard for the sector feature grid). */
interface Props {
  image: ImageMetadata;
  imageAlt: string;
  heading: string;
  body: string;
}
const { image, imageAlt, heading, body } = Astro.props;
---

<article class="sfc reveal">
  <div class="sfc__media">
    <Image src={image} alt={imageAlt} width={1280} height={1040} loading="lazy" />
  </div>
  <div class="sfc__panel">
    <h3 class="sfc__heading">{heading}</h3>
    <p class="sfc__body">{body}</p>
  </div>
</article>

<script>
  import { initReveal } from '../scripts/reveal';
  document.addEventListener('astro:page-load', initReveal);
  initReveal();
</script>

<style>
  .sfc {
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
    contain: paint;
    box-shadow: var(--shadow-card);
    background: #fff;
    max-width: 1280px;
    margin-inline: auto;
  }
  .sfc__media {
    position: relative;
    aspect-ratio: 4 / 2.4;
    overflow: hidden;
  }
  .sfc__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sfc__panel {
    position: relative;
    z-index: 2;
    margin-top: -30%;
    background: rgb(255 255 255 / 0.82);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-radius: 20px 20px 0 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1.25rem, 2.5vw, 1.75rem) clamp(1.5rem, 2.5vw, 1.75rem);
    display: grid;
    gap: 0.5rem;
  }
  .sfc__heading { font-size: clamp(1.15rem, 1.8vw, 1.4rem); color: var(--color-ink); min-height: 2.6em; }
  .sfc__body { color: var(--color-slate-muted); font-size: 0.98rem; line-height: 1.55; min-height: 6.8em; }

  @media (max-width: 480px) {
    .sfc__media { aspect-ratio: 16 / 11; }
    .sfc__panel { margin-top: -20%; }
  }
</style>
