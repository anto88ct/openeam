---
interface Props {
  quote: string;
  author: string;
  company?: string;
}
const { quote, author, company } = Astro.props;
---
<figure class="quote">
  <blockquote class="quote__text">“{quote}”</blockquote>
  <figcaption class="quote__cite">
    <span class="quote__author">{author}</span>
    {company && <span class="quote__company">{company}</span>}
  </figcaption>
</figure>

<style>
  .quote { max-width: 60rem; margin-inline: auto; text-align: center; }
  .quote__text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.4rem, 3vw, 2.15rem);
    line-height: 1.3;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }
  .quote__cite {
    margin-top: 1.75rem;
    display: grid;
    gap: 0.15rem;
  }
  .quote__author { font-weight: 700; color: var(--color-ink); }
  .quote__company { color: var(--color-slate-muted); font-size: 0.95rem; }
</style>
