---
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
{lang === 'it' ? (
  <svg class="flag-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <clipPath id="flag-circle-it"><circle cx="12" cy="12" r="12" /></clipPath>
    <g clip-path="url(#flag-circle-it)">
      <rect x="0" y="0" width="8" height="24" fill="#009246" />
      <rect x="8" y="0" width="8" height="24" fill="#fff" />
      <rect x="16" y="0" width="8" height="24" fill="#ce2b37" />
    </g>
  </svg>
) : (
  <svg class="flag-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <clipPath id="flag-circle-en"><circle cx="12" cy="12" r="12" /></clipPath>
    <g clip-path="url(#flag-circle-en)">
      <rect x="0" y="0" width="24" height="24" fill="#00247d" />
      <path d="M0 0 24 24M24 0 0 24" stroke="#fff" stroke-width="3.2" />
      <path d="M0 0 24 24M24 0 0 24" stroke="#cf142b" stroke-width="1.4" />
      <path d="M12 0V24M0 12H24" stroke="#fff" stroke-width="5.4" />
      <path d="M12 0V24M0 12H24" stroke="#cf142b" stroke-width="3" />
    </g>
  </svg>
)}

<style>
  .flag-icon {
    display: block;
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgb(35 48 56 / 0.12);
  }
</style>
