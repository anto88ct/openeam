---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import TeamMarquee from '../TeamMarquee.astro';
import { useTranslations } from '../../i18n/utils';

import blobBg from '../../assets/img/pricing/blob-bg.svg';
import statementBg from '../../assets/img/azienda/bg.png';
import heroImg from '../../assets/img/azienda/hero.jpg';
import assetManagementImg from '../../assets/img/azienda/asset-management.avif';
import maintenanceOpsImg from '../../assets/img/azienda/maintenance-operations.avif';

import photoSeminara from '../../assets/img/team/seminara.png';
import photoTerrito from '../../assets/img/team/territo.jpg';
import photoDiBlasi from '../../assets/img/team/diblasi.jpg';
import photoFortunato from '../../assets/img/team/fortunato.jpg';
import photoCunsolo from '../../assets/img/team/cunsolo.jpg';
import photoDarrigo from '../../assets/img/team/darrigo.jpg';
import photoPaglia from '../../assets/img/team/paglia.png';
import photoCampagna from '../../assets/img/team/campagna.png';

interface Props {
  lang: 'it' | 'en';
}
const { lang } = Astro.props;
const tUi = useTranslations(lang);

const COPY = {
  it: {
    title: 'Seedma — Chi siamo',
    description:
      "Seedma: 25 anni di know-how, in un software. Scopri la storia, la missione e il team dietro Open EAM.",
    heroLead: 'Seedma',
    heroTrail: ": 25 anni di know-how, in un software",
    introParas: [
      "Nata nel 2020 come spin-off di Teseo Srl, Seedma sviluppa moduli software integrati per la gestione di impianti industriali, civili e strutture complesse. Il nostro know-how nell'Operations & Maintenance, maturato in oltre 25 anni di esperienza nell'Oil & Gas, si traduce in soluzioni innovative che ottimizzano i processi operativi e migliorano l'efficienza, la gestione delle infrastrutture e la sostenibilità delle imprese.",
      'Dal 2024 facciamo parte della rete Le Village by Crédit Agricole.',
    ],
    cards: [
      {
        heading: 'Dai dati operativi alle decisioni strategiche',
        body: "Le nostre soluzioni software consentono di acquisire, elaborare, condividere e utilizzare i dati provenienti dagli impianti e dalle infrastrutture per orientare le decisioni strategiche. Un modello di business agile e snello che accompagna le aziende nell'evoluzione dei propri processi.",
      },
      {
        heading: 'Consulenza e software personalizzati',
        body: "Proponiamo ai nostri clienti software e servizi di consulenza correlati, tra cui assessment, formazione e supporto post-vendita. Completiamo l'offerta con moduli specialistici, app mobili e contratti di assistenza dedicati, per configurare ogni soluzione in base alle esigenze del cliente.",
      },
    ],
    statementHeading: 'Esperienza, flessibilità, risultati concreti',
    statementParas: [
      'La nostra missione è contribuire al successo dei clienti con esperienza concreta sul campo, competenze tecnologiche e soluzioni costruite sulle loro esigenze reali.',
      "Affianchiamo organizzazioni che operano in contesti complessi, aiutandole a rendere più chiari, efficienti e controllabili i processi legati all'Operations & Maintenance. Lo facciamo con una struttura flessibile e modulare, capace di concepire, sviluppare e gestire progetti innovativi con un obiettivo preciso: trasformare la complessità in risultati concreti.",
    ],
    teamHeading: 'Le competenze dietro ogni progetto',
    teamSub:
      "Seedma unisce esperienza imprenditoriale, comprensione dei processi, gestione del progetto e sviluppo software. Un team con profili senior e giovani sviluppatori formati su tecnologie digitali, capace di seguire ogni progetto dall'analisi delle esigenze alla configurazione della soluzione, fino al supporto operativo.",
    team: [
      { name: 'Mario Seminara', role: 'Founder e CEO' },
      { name: 'Davide Territo', role: 'Project Manager, Laurea in Ingegneria Aerospaziale, Oltre 10 anni di esperienza' },
      { name: 'Giuseppe Di Blasi', role: 'Analista senior, Laurea in Informatica, Oltre 10 anni di esperienza' },
      { name: 'Carmelo Fortunato', role: 'Sviluppatore senior, Laurea Specialistica in Informatica, Oltre 10 anni di esperienza' },
      { name: 'Mario Cunsolo', role: 'Sviluppatore junior full stack, ITS Steve Jobs Academy' },
      { name: "Antonio D'Arrigo", role: 'Sviluppatore junior full stack' },
      { name: 'Matteo Paglia', role: 'Sviluppatore junior full stack, ITS Steve Jobs Academy' },
      { name: 'Salvatore Campagna', role: 'Marketing and sales, Laurea in economia aziendale e marketing digitale' },
    ],
  },
  en: {
    title: 'Seedma — About us',
    description:
      'Seedma: twenty years of know-how, built into software. Discover the story, mission, and team behind Open EAM.',
    heroLead: 'Seedma',
    heroTrail: ': twenty years of know-how, built into software',
    introParas: [
      'Founded in 2020 as a spin-off of Teseo Srl, Seedma develops integrated software modules for managing industrial plants, civil infrastructure, and complex facilities. Our Operations & Maintenance know-how, built on more than twenty years of experience in Oil & Gas, translates into innovative solutions that optimize operational processes and improve efficiency, infrastructure management, and business sustainability.',
      "Since 2024 we've been part of the Le Village by Crédit Agricole network.",
    ],
    cards: [
      {
        heading: 'From operational data to strategic decisions',
        body: "Our software solutions let you acquire, process, share, and use data from plants and infrastructure to guide strategic decisions. A lean, agile business model that supports companies as their processes evolve.",
      },
      {
        heading: 'Consulting and tailored software',
        body: "We offer our clients software and related consulting services, including assessments, training, and after-sales support. We round out the offering with specialist modules, mobile apps, and dedicated support contracts, configuring every solution around the client's needs.",
      },
    ],
    statementHeading: 'Experience, flexibility, concrete results',
    statementParas: [
      "Our mission is to contribute to our clients' success with hands-on field experience, technological expertise, and solutions built around their real needs.",
      'We work alongside organizations operating in complex environments, helping them make their Operations & Maintenance processes clearer, more efficient, and more controllable. We do this with a flexible, modular structure capable of designing, developing, and managing innovative projects with one precise goal: turning complexity into concrete results.',
    ],
    teamHeading: 'The expertise behind every project',
    teamSub:
      "Seedma brings together entrepreneurial experience, process understanding, project management, and software development. A team of senior profiles and young developers trained in digital technologies, able to follow every project from requirements analysis to solution configuration and ongoing operational support.",
    team: [
      { name: 'Mario Seminara', role: 'Founder & CEO' },
      { name: 'Davide Territo', role: "Project Manager, Master's degree in Aerospace Engineering, Over 10 years of experience" },
      { name: 'Giuseppe Di Blasi', role: 'Senior Analyst, Degree in Computer Science, Over 10 years of experience' },
      { name: 'Carmelo Fortunato', role: "Senior Developer, Master's degree in Computer Science, Over 10 years of experience" },
      { name: 'Mario Cunsolo', role: 'Junior Full-Stack Developer, ITS Steve Jobs Academy' },
      { name: "Antonio D'Arrigo", role: 'Junior Full-Stack Developer' },
      { name: 'Matteo Paglia', role: 'Junior Full-Stack Developer, ITS Steve Jobs Academy' },
      { name: 'Salvatore Campagna', role: 'Marketing & Sales, Degree in Business Economics and Digital Marketing' },
    ],
  },
} as const;
const t = COPY[lang];

const teamPhotos = [
  photoSeminara,
  photoTerrito,
  photoDiBlasi,
  photoFortunato,
  photoCunsolo,
  photoDarrigo,
  photoPaglia,
  photoCampagna,
];
const photoScales = [1, 1, 1, 1, 1, 1, 1, 0.8]; // Salvatore Campagna's crop reads tighter than the rest
const teamLinkedin = [
  'https://www.linkedin.com/in/mario-seminara-38136129/',
  'https://www.linkedin.com/in/davide-territo/',
  'https://www.linkedin.com/in/giuseppe-di-blasi-53172120a/',
  'https://www.linkedin.com/in/carmelo-fortunato-4b79556b/',
  'https://www.linkedin.com/in/mario-cunsolo/',
  'https://www.linkedin.com/in/antonio-d-arrigo-5419a12a0/',
  'https://www.linkedin.com/in/matteo-paglia-b1302130a/',
  'https://www.linkedin.com/in/salvatore-campagna-998420332/',
];
const members = t.team.map((m, i) => ({
  ...m,
  photo: teamPhotos[i],
  scale: photoScales[i],
  linkedin: teamLinkedin[i],
}));
---

<BaseLayout title={t.title} description={t.description}>
  <!-- Hero statement -->
  <Section bg="light" class="azienda-hero">
    <Image src={blobBg} alt="" class="azienda-hero__blob" aria-hidden="true" />
    <h1 class="azienda-hero__title">
      <span class="hl">{t.heroLead}</span>{t.heroTrail}
    </h1>
  </Section>

  <!-- Intro split -->
  <Section bg="light" class="intro-split-section">
    <div class="intro-split">
      <div class="intro-split__media">
        <Image src={heroImg} alt="" width={900} height={1000} loading="eager" />
      </div>
      <div class="intro-split__text card">
        {t.introParas.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </Section>

  <!-- Feature cards -->
  <Section bg="light">
    <div class="feature-cards">
      {t.cards.map((c, i) => (
        <article class="feature-card card">
          <div class="feature-card__media">
            <Image
              src={i === 0 ? assetManagementImg : maintenanceOpsImg}
              alt=""
              width={640}
              height={440}
              loading="lazy"
            />
          </div>
          <div class="feature-card__body">
            <h3 class="feature-card__heading">{c.heading}</h3>
            <p class="feature-card__text">{c.body}</p>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <!-- Statement -->
  <Section bg="ink" class="statement">
    <Image src={statementBg} alt="" class="statement__bg" aria-hidden="true" />
    <div class="statement__content">
      <h2 class="statement__heading">{t.statementHeading}</h2>
      {t.statementParas.map((p) => <p class="statement__body">{p}</p>)}
    </div>
  </Section>

  <!-- Team -->
  <!-- <Section bg="light">
    <SectionHeading heading={t.teamHeading} sub={t.teamSub} />
    <div class="team-marquee-wrap">
      <TeamMarquee members={members} />
    </div>
  </Section> -->
</BaseLayout>

<style>
  .azienda-hero {
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .azienda-hero__blob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(120%, 1400px);
    height: auto;
    transform: translate(-50%, -50%) scale(1.4);
    opacity: 1;
    pointer-events: none;
    z-index: 0;
  }
  .azienda-hero :global(.container-page) {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    justify-items: center;
  }
  .azienda-hero__title {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    line-height: 1.25;
    text-wrap: balance;
  }
  .azienda-hero__title .hl { color: var(--color-orange); }

  .intro-split-section { padding-top: 0 !important; }
  .intro-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: stretch;
  }
  .intro-split__media {
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    min-height: 340px;
  }
  .intro-split__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .intro-split__text {
    background: rgb(35 48 56 / 0.07);
    padding: clamp(2rem, 4vw, 2.75rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.1rem;
    box-shadow: none;
  }
  .intro-split__text p {
    color: var(--color-slate);
    font-size: 1.05rem;
    line-height: 1.7;
  }
  @media (max-width: 820px) {
    .intro-split { grid-template-columns: 1fr; }
    .intro-split__media { min-height: 260px; }
  }

  .feature-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 2rem);
  }
  .feature-card {
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .feature-card__media { aspect-ratio: 16 / 10; }
  .feature-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .feature-card__body {
    padding: clamp(1.5rem, 3vw, 2rem);
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .feature-card__heading { font-size: 1.3rem; }
  .feature-card__text { color: var(--color-slate-muted); line-height: 1.6; }
  @media (max-width: 720px) {
    .feature-cards { grid-template-columns: 1fr; }
  }

  .statement {
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .statement__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    z-index: 0;
  }
  .statement__content {
    position: relative;
    z-index: 1;
    max-width: 52rem;
    margin-inline: auto;
    display: grid;
    gap: 1.25rem;
  }
  .statement__heading { color: #fff; font-size: clamp(1.7rem, 3.4vw, 2.6rem); }
  .statement__body { color: rgb(255 255 255 / 0.9); font-size: 1.1rem; line-height: 1.7; }

  .team-marquee-wrap { margin-top: 3.5rem; }
</style>
