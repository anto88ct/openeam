const t = COPY[lang];
---

<BaseLayout title="Pricing" description={t.description}>
  <!-- Hero statement -->
  <Section bg="light" class="pricing-hero">
    <Image src={blobBg} alt="" class="pricing-hero__blob" aria-hidden="true" />
    <p class="price-hero">
      {t.heroLead}<span class="hl">{t.heroHl}</span>{t.heroTrail}
    </p>
  </Section>

  <!-- Tiers -->
  <Section bg="light">
    <div class="tiers">
      {
        t.tiers.map((tier, i) => (
          <article class="tier card">
            <div class="tier__img">
              <Image
                src={[imgStart, imgMid, imgPro][i]}
                alt=""
                width={260}
                height={200}
                loading="lazy"
              />
            </div>
            <h3 class="tier__title">{tier.title}</h3>
            <ul class="tier__list">
              {tier.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- SaaS / On premise -->
  <Section bg="light">
    <div class="plans">
      <div class="plan plan--saas card">
        <div class="plan__icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M17.5 19a4.5 4.5 0 0 0 0-9 6 6 0 0 0-11.3-1.8A4.5 4.5 0 0 0 6.5 19h11Z"
            ></path></svg
          >
        </div>
        <h3 class="plan__title">{t.saasTitle}</h3>
        <p class="plan__body">{t.saasBody}</p>
      </div>
      <div class="plan plan--onprem card">
        <div class="plan__icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect x="4" y="4" width="16" height="6" rx="1.2"></rect><rect
              x="4"
              y="14"
              width="16"
              height="6"
              rx="1.2"></rect><circle
              cx="8"
              cy="7"
              r="0.6"
              fill="currentColor"
              stroke="none"></circle><circle
              cx="8"
              cy="17"
              r="0.6"
              fill="currentColor"
              stroke="none"></circle></svg
          >
        </div>
        <h3 class="plan__title">{t.onPremTitle}</h3>
        <p class="plan__body">{t.onPremBody}</p>
      </div>
    </div>
  </Section>

  <!-- ROI -->
  <Section bg="light">
    <div class="roi">
      <div class="roi__narrative card">
        <h2 class="roi__title">
          {t.roiHeadingLead}<span class="hl">{t.roiHeadingHl}</span>
        </h2>
        <p class="roi__lead">{t.roiLead}</p>
        {t.roiParas.map((p) => <p set:html={p} />)}
      </div>
      <div class="roi__grid card" data-roi-grid>
        {
          t.roi.map((r, i) => (
            <div class="roi__row" style={`--i: ${i}`}>
              <span class="chip chip--problem">{r.problem}</span>
              <span class:list={["chip", `chip--${r.tone}`]}>
                → {r.benefit}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <script>
    function initRoiReveal() {
      const rows = document.querySelectorAll<HTMLElement>(
        ".roi__row:not([data-roi-inited])",
      );
      if (!rows.length) return;

      const reveal = (row: HTMLElement) => {
        row.dataset.roiInited = "true";
        row.classList.add("is-visible");
      };

      if (!("IntersectionObserver" in window)) {
        rows.forEach(reveal);
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              reveal(entry.target as HTMLElement);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.4 },
      );
      rows.forEach((row) => observer.observe(row));
    }

    document.addEventListener("astro:page-load", initRoiReveal);
    initRoiReveal();
  </script>

  <!-- Contact CTA -->
  <Section bg="light" class="contact-cta-section">
    <div class="contact-cta">
      <Button href={l("/demo")} variant="primary" class="contact-cta__btn"
        >{t.contactCta}</Button
      >
    </div>
  </Section>

  <!-- Trust -->
  <Section bg="white">
    <LogoMarquee heading={tUi("trustHeading")} mono={false} />
  </Section>

  <!-- FAQ -->
  <Section bg="white">
    <SectionHeading heading={t.faqHeading} />
    <div class="faq-wrap"><Faq items={t.faqs} /></div>
  </Section>
</BaseLayout>

<style>
  .pricing-hero {
    position: relative;
    overflow: hidden;
  }
  .pricing-hero__blob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(120%, 1400px);
    height: auto;
    transform: translate(-50%, -50%) scale(1.4);
    opacity: 1;
    pointer-events: none;
    z-index: 0;
  }
  .pricing-hero :global(.container-page) {
    position: relative;
    z-index: 1;
  }

  @keyframes price-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .price-hero {
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
    text-wrap: balance;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3.6vw, 2.6rem);
    line-height: 1.3;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    animation: price-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .price-hero .hl {
    color: var(--color-orange);
  }
  @media (prefers-reduced-motion: reduce) {
    .price-hero {
      animation: none;
    }
  }

  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .tier {
    padding: 2rem;
    display: grid;
    gap: 1.25rem;
    align-content: start;
    text-align: center;
    transition:
      transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tier:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px -20px rgb(35 48 56 / 0.3);
  }
  .tier__img {
    display: grid;
    place-items: center;
    min-height: 150px;
  }
  .tier__img :global(img) {
    width: auto;
    max-height: 160px;
    object-fit: contain;
    animation: tier-float 4.5s ease-in-out infinite;
  }
  .tier:nth-child(2) .tier__img :global(img) {
    animation-delay: 0.3s;
  }
  .tier:nth-child(3) .tier__img :global(img) {
    animation-delay: 0.6s;
  }
  @keyframes tier-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  .tier__title {
    font-size: 1.3rem;
  }
  .tier__list {
    list-style: none;
    display: grid;
    gap: 0.7rem;
    text-align: left;
  }
  .tier__list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--color-slate);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .tier__list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-orange);
    font-weight: 700;
  }
  @media (max-width: 860px) {
    .tiers {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tier {
      transition: none;
    }
    .tier:hover {
      transform: none;
    }
    .tier__img :global(img) {
      animation: none;
    }
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .plan {
    padding: 2.25rem;
    display: grid;
    gap: 0.9rem;
    align-content: start;
    border: 1px solid rgb(35 48 56 / 0.07);
    transition:
      transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .plan:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px -20px rgb(35 48 56 / 0.3);
  }
  .plan__icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: grid;
    place-items: center;
  }
  .plan__icon svg {
    width: 28px;
    height: 28px;
  }
  .plan--saas .plan__icon {
    background: rgb(70 165 163 / 0.12);
    color: var(--color-teal);
  }
  .plan--onprem .plan__icon {
    background: rgb(245 139 84 / 0.12);
    color: var(--color-orange);
  }
  .plan__title {
    font-size: 1.5rem;
  }
  .plan__body {
    color: var(--color-slate);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .plans {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plan {
      transition: none;
    }
    .plan:hover {
      transform: none;
    }
  }

  .roi {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: stretch;
  }
  .roi__narrative {
    padding: 2.25rem;
    display: grid;
    gap: 0.9rem;
  }
  .roi__title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .roi__title .hl {
    color: var(--color-orange);
  }
  .roi__lead {
    font-weight: 600;
    color: var(--color-ink);
    font-size: 1.1rem;
  }
  .roi__narrative p {
    color: var(--color-slate);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  .roi__grid {
    padding: 1.75rem;
    display: grid;
    gap: 0.9rem;
    align-content: center;
  }
  .roi__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .chip {
    display: flex;
    align-items: center;
    padding: 1.1rem 1.4rem;
    border-radius: 12px;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .chip--problem {
    background: #d2d8d9;
    color: var(--color-ink);
  }
  .chip--teal {
    background: #46a5a3;
    color: #fff;
  }
  .chip--orange {
    background: #f58b54;
    color: #fff;
  }

  /* Reveal: the gray "problem" chip settles in first, then the colored
