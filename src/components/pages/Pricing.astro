---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../Section.astro";
import SectionHeading from "../SectionHeading.astro";
import LogoMarquee from "../LogoMarquee.astro";
import Faq from "../Faq.astro";
import Button from "../Button.astro";
import { getLocalizedPath, useTranslations } from "../../i18n/utils";

import imgStart from "../../assets/img/pricing/start.png";
import imgMid from "../../assets/img/pricing/mid.png";
import imgPro from "../../assets/img/pricing/pro.png";
import blobBg from "../../assets/img/pricing/blob-bg.svg";

interface Props {
  lang: "it" | "en";
}
const { lang } = Astro.props;
const l = (href: string) => getLocalizedPath(lang, href);
const tUi = useTranslations(lang);

