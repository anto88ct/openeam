---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../Section.astro';
import PlatformHero from '../PlatformHero.astro';
import FeatureSplit from '../FeatureSplit.astro';
import CtaBand from '../CtaBand.astro';
import LottiePlayer from '../LottiePlayer.astro';
import { getLocalizedPath } from '../../i18n/utils';

import heroPhoto from '../../assets/img/control-panel.avif';
import closingPhoto from '../../assets/img/worker-industry.avif';

interface Props {
  lang: 'it' | 'en';
}
const { lang } = Astro.props;
const l = (href: string) => getLocalizedPath(lang, href);

const COPY = {
  it: {
    description: 'OpenEAM centralizza e organizza ogni asset in una struttura solida, scalabile e flessibile, modellandosi sui tuoi processi per contesti multi-sito e complessi.',
    heroSub: 'OpenEAM centralizza e organizza ogni asset in una struttura solida, scalabile e flessibile. A differenza degli EAM tradizionali, non sei tu ad adattarti al software: la piattaforma si modella sui tuoi processi, permettendoti di operare in contesti multi-sito, complessi e in continua evoluzione.',
    heroImgAlt: 'Quadro di controllo industriale',
    features: [
      { heading: 'Struttura solida e scalabile dei tuoi asset', body: 'Organizza tutti gli asset, dagli impianti industriali alle attrezzature, in una struttura coerente e facilmente navigabile. La modularità della piattaforma ti consente di partire con la configurazione essenziale e ampliarla nel tempo, restando sempre allineata ai tuoi processi.', anim: 'Verniciatura_Essicazione_Movimentazione' },
      { heading: 'Gestione multisito e localizzazioni complesse', body: 'Gestire sedi e impianti in più località non significa rinunciare alla coerenza operativa. Open EAM ti permette di mappare, monitorare e intervenire su asset distribuiti mantenendo procedure e standard condivisi. I flussi di lavoro sono modellati sulle esigenze di ogni sito, ma coordinati in un unico sistema centrale.', anim: 'Verono_Roma_Catania' },
      { heading: 'Integrazione intelligente dei dati (ETL)', body: 'Collega Open EAM alle tue fonti dati (ERP, SCADA, IoT o database esterni) e trasforma informazioni eterogenee in un patrimonio unico e coerente. Grazie ai processi ETL nativi, i dati vengono uniformati e integrati nei tuoi flussi, così non dovrai cambiare strumenti o procedure collaudate.', anim: 'file_cad_open_EAM_modello_BIM' },
    ],
    ctaHeading: "Un'architettura modulare, costruita attorno ai tuoi processi",
    ctaBody: "Non piegare i tuoi processi alle regole di un software preconfezionato. Scopri l'EAM modulare costruito a misura della tua azienda.",
    ctaImgAlt: 'Operatore in impianto',
    ctaLabel: 'Richiedi una demo',
  },
  en: {
    description: 'OpenEAM centralizes and organizes every asset in a solid, scalable, and flexible structure, molding itself to your processes for multi-site and complex environments.',
    heroSub: "OpenEAM centralizes and organizes every asset in a solid, scalable, and flexible structure. Unlike traditional EAM systems, you don't adapt to the software — the platform molds itself to your processes, letting you operate in multi-site, complex, and constantly evolving environments.",
    heroImgAlt: 'Industrial control panel',
    features: [
      { heading: 'A solid, scalable structure for your assets', body: "Organize every asset, from industrial plants to equipment, into a coherent, easy-to-navigate structure. The platform's modularity lets you start with the essential setup and expand it over time, always staying aligned with your processes.", anim: 'Verniciatura_Essicazione_Movimentazione' },
      { heading: 'Multi-site management and complex locations', body: "Managing sites and plants across multiple locations doesn't mean giving up operational consistency. Open EAM lets you map, monitor, and act on distributed assets while keeping shared procedures and standards. Workflows are shaped around each site's needs, but coordinated in a single central system.", anim: 'Verono_Roma_Catania' },
      { heading: 'Smart data integration (ETL)', body: "Connect Open EAM to your data sources (ERP, SCADA, IoT, or external databases) and turn heterogeneous information into a single, coherent asset. Thanks to native ETL processes, data is standardized and integrated into your workflows, so you won't have to change proven tools or procedures.", anim: 'file_cad_open_EAM_modello_BIM' },
    ],
    ctaHeading: 'A modular architecture, built around your processes',
    ctaBody: "Don't bend your processes to fit an off-the-shelf software's rules. Discover the modular EAM built to your company's exact measure.",
    ctaImgAlt: 'Operator at a plant',
    ctaLabel: 'Request a demo',
  },
} as const;
const t = COPY[lang];
---
<BaseLayout title="Asset Management — OpenEAM Platform" description={t.description}>

  <PlatformHero tone="ink" accent="orange" icon="gear" headingLead="Asset" headingAccent="management" sub={t.heroSub} ctaLabel={t.ctaLabel} ctaHref={l('/demo')}>
    <Image src={heroPhoto} alt={t.heroImgAlt} width={720} height={540} />
  </PlatformHero>

  <Section bg="white">
    <div class="stack">
      {t.features.map((f) => (
        <FeatureSplit heading={f.heading} body={f.body} ctaLabel={t.ctaLabel} ctaHref={l('/demo')}>
          <div class="lottie-box">
            <LottiePlayer animationName={f.anim} ariaLabel={f.heading} />
          </div>
        </FeatureSplit>
      ))}
    </div>
  </Section>

  <Section bg="white">
    <CtaBand tone="ink" image={closingPhoto} imageAlt={t.ctaImgAlt} heading={t.ctaHeading} body={t.ctaBody} ctaLabel={t.ctaLabel} ctaHref={l('/demo')} />
  </Section>

</BaseLayout>

<style>
  .stack { display: grid; gap: 2rem; }
  .lottie-box { width: 100%; min-height: 300px; display: grid; place-items: center; }
</style>
