---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import CaseStudyCard from '../CaseStudyCard.astro';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  lang: 'it' | 'en';
}
const { lang } = Astro.props;
const l = (href: string) => getLocalizedPath(lang, href);
const collection = lang === 'en' ? 'caseStudiesEn' : 'caseStudiesIt';

const items = (await getCollection(collection))
  .filter((c) => !c.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const COPY = {
  it: {
    description: 'Scopri come le aziende industriali usano Open EAM per migliorare efficienza e performance della manutenzione.',
    heading: 'Casi studio',
    sub: "Scopri come altre aziende utilizzano Open EAM per migliorare l'efficienza e le performance della manutenzione nei loro impianti produttivi.",
    caseCtaLabel: 'Scopri di più',
  },
  en: {
    description: 'Discover how industrial companies use Open EAM to improve efficiency and maintenance performance.',
    heading: 'Case studies',
    sub: 'See how other companies use Open EAM to improve efficiency and maintenance performance at their production plants.',
    caseCtaLabel: 'Learn more',
  },
} as const;
const t = COPY[lang];
---
<BaseLayout title="Case Studies" description={t.description}>
  <Section bg="ink" dotted>
    <SectionHeading heading={t.heading} sub={t.sub} />
  </Section>

  <Section bg="light">
    <div class="cs-grid">
      {items.map((c) => (
        <CaseStudyCard
          title={c.data.title}
          href={l(`/case-studies/${c.id}`)}
          image={c.data.heroImage}
          imageAlt={c.data.title}
          body={c.data.excerpt}
          ctaLabel={t.caseCtaLabel}
        />
      ))}
    </div>
  </Section>
</BaseLayout>

<style>
  .cs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  @media (max-width: 940px) { .cs-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .cs-grid { grid-template-columns: 1fr; } }
</style>
