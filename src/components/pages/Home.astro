---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import ModuleCard from '../ModuleCard.astro';
import Testimonial from '../Testimonial.astro';
import LogoMarquee from '../LogoMarquee.astro';
import CtaBand from '../CtaBand.astro';
import CaseStudyCard from '../CaseStudyCard.astro';
import Button from '../Button.astro';
import { getLocalizedPath } from '../../i18n/utils';

import heroRings from '../../assets/img/hero-rings.svg';
import featAsset from '../../assets/img/feat-asset-management.avif';
import featMaint from '../../assets/img/feat-maintenance.avif';
import featDoc from '../../assets/img/feat-documentation.avif';
import featAnalytics from '../../assets/img/feat-analytics.avif';
import workerIndustry from '../../assets/img/worker-industry.avif';
import iconGear from '../../assets/icons/gear.svg';
import iconWrench from '../../assets/icons/wrench.svg';
import iconDocument from '../../assets/icons/document.svg';
import iconChart from '../../assets/icons/chart.svg';
import caseSt from '../../assets/img/cases/st.png';
import caseSonatrach from '../../assets/img/cases/sonatrach.avif';
import caseSasol from '../../assets/img/cases/sasol.avif';
import caseSac from '../../assets/img/cases/sac.avif';

interface Props {
  lang: 'it' | 'en';
}
const { lang } = Astro.props;
const l = (href: string) => getLocalizedPath(lang, href);

const COPY = {
  it: {
    title: 'OpenEAM, la Piattaforma Modulare che Prende la Forma dei Tuoi Processi',
    description: "Open EAM unisce manutenzione, asset management e controllo operativo in un'unica piattaforma flessibile che si adatta ai tuoi processi. E non viceversa.",
    heroTitleLead: 'Mantieni i tuoi asset industriali ',
    heroTitleHl: "al massimo dell'efficienza.",
    heroSub: "Open EAM è la piattaforma che unisce manutenzione, asset management e controllo operativo in un unico sistema flessibile, che si adatta ai tuoi processi.",
    heroSubStrong: 'E non viceversa.',
    ctaDemo: 'Richiedi una demo',
    ctaVideoTour: 'Video tour della piattaforma',
    modulesHeading: "Manutenzione, asset management, documenti e analytics in una piattaforma che prende la forma dei tuoi processi",
    modulesSub: "Open EAM racchiude in un unico sistema <strong>modulare</strong> e <strong>personalizzabile</strong> tutte le funzioni necessarie a mantenere impianti produttivi organizzati e performanti, a ridurre i fermi impianto e a migliorare l'efficienza.",
    modules: [
      { heading: 'Asset Management', body: 'Ottimizza il ciclo di vita degli asset con <strong>gestione centralizzata</strong>, <strong>visibilità completa</strong> e <strong>integrazione dei dati</strong>, anche in organizzazioni multisito con strutture complesse.' },
      { heading: 'Maintenance & Operations', body: 'Pianifica, traccia e ottimizza attività manutentive <strong>programmate</strong>, <strong>predittive</strong> e <strong>correttive</strong> con flussi personalizzati sulle tue procedure e sui tuoi impianti, riducendo downtime e sprechi di risorse.' },
      { heading: 'Technical Documentation', body: 'Centralizza e collega la documentazione tecnica agli asset, integrandola nei flussi operativi per un <strong>accesso immediato</strong> e <strong>sicuro</strong>, ovunque ti trovi.' },
      { heading: 'Asset Analytics', body: 'Trasforma dati IoT, geospaziali e digital twin in <strong>insight</strong> immediatamente azionabili, con <strong>KPI</strong> e <strong>dashboard</strong> sempre disponibili per essere utilizzati nei processi decisionali.' },
    ],
    cases: [
      { title: 'ST Microelectronics', body: "Oltre 40.000 interventi gestiti ogni anno e più dell'80% di attività pianificate: con Open EAM, STMicroelectronics ha trasformato la gestione della manutenzione." },
      { title: 'Sonatrach', body: "Nei depositi di Augusta, Napoli e Palermo, Sonatrach usa Open EAM per gestire manutenzione, ispezioni e controlli navi in un'unica piattaforma." },
      { title: 'Sasol', body: "Sasol usa Open EAM per gestire 60.000 documenti tecnici, revisioni, manuali operativi e ispezioni antincendio in un'unica piattaforma integrata." },
      { title: 'SAC', body: "SAC adotta Open EAM per gestire asset, ispezioni, ticket e documentazione tecnica in un'unica piattaforma di manutenzione integrata." },
    ],
    testimonialQuote: "Open EAM ha reso semplice ciò che prima era frammentato: oggi gestiamo manutenzione, ispezioni e asset su un'unica piattaforma, che sembra cucita addosso a noi.",
    architectureHeading: "Un'architettura modulare, costruita attorno ai tuoi processi",
    architectureBody: "Non piegare i tuoi processi alle regole di un software preconfezionato. Scopri l'EAM modulare costruito a misura della tua azienda.",
    architectureCta: 'Vai al video tour della piattaforma',
    architectureAlt: 'Operatore al lavoro in impianto industriale',
    casesHeading: 'Casi studio',
    casesSub: "Scopri come altre aziende utilizzano Open EAM per migliorare l'efficienza e le performance della manutenzione nei loro impianti produttivi.",
    casesExploreAll: 'Esplora tutti i case studies',
  },
  en: {
    title: 'OpenEAM, the Modular Platform That Takes the Shape of Your Processes',
    description: "Open EAM brings maintenance, asset management, and operational control together in one flexible platform that adapts to your processes. Not the other way around.",
    heroTitleLead: 'Keep your industrial assets ',
    heroTitleHl: 'running at peak efficiency.',
    heroSub: 'Open EAM is the platform that brings maintenance, asset management, and operational control together in one flexible system that adapts to your processes.',
    heroSubStrong: 'Not the other way around.',
    ctaDemo: 'Request a demo',
    ctaVideoTour: 'Platform video tour',
    modulesHeading: 'Maintenance, asset management, documents, and analytics in one platform that takes the shape of your processes',
    modulesSub: 'Open EAM brings together, in one <strong>modular</strong> and <strong>customizable</strong> system, all the functions needed to keep production plants organized and high-performing, reduce downtime, and improve efficiency.',
    modules: [
      { heading: 'Asset Management', body: 'Optimize the asset lifecycle with <strong>centralized management</strong>, <strong>complete visibility</strong>, and <strong>data integration</strong>, even across multi-site organizations with complex structures.' },
      { heading: 'Maintenance & Operations', body: 'Plan, track, and optimize <strong>scheduled</strong>, <strong>predictive</strong>, and <strong>corrective</strong> maintenance activities with workflows tailored to your procedures and plants, reducing downtime and wasted resources.' },
      { heading: 'Technical Documentation', body: 'Centralize technical documentation and link it to your assets, integrating it into operational workflows for <strong>immediate</strong> and <strong>secure access</strong>, wherever you are.' },
      { heading: 'Asset Analytics', body: 'Turn IoT, geospatial, and digital twin data into <strong>immediately actionable insights</strong>, with <strong>KPIs</strong> and <strong>dashboards</strong> always available to support decision-making.' },
    ],
    cases: [
      { title: 'ST Microelectronics', body: 'Over 40,000 work orders handled every year and more than 80% of planned activity: with Open EAM, STMicroelectronics transformed its maintenance management.' },
      { title: 'Sonatrach', body: 'At its Augusta, Naples, and Palermo depots, Sonatrach uses Open EAM to manage maintenance, inspections, and vessel checks on a single platform.' },
      { title: 'Sasol', body: 'Sasol uses Open EAM to manage 60,000 technical documents, revisions, operating manuals, and fire-safety inspections on a single integrated platform.' },
      { title: 'SAC', body: 'SAC adopted Open EAM to manage assets, inspections, tickets, and technical documentation on a single integrated maintenance platform.' },
    ],
    testimonialQuote: 'Open EAM made simple what used to be fragmented: today we manage maintenance, inspections, and assets on a single platform that feels tailor-made for us.',
    architectureHeading: 'A modular architecture, built around your processes',
    architectureBody: "Don't bend your processes to fit an off-the-shelf software's rules. Discover the modular EAM built to your company's exact measure.",
    architectureCta: 'Watch the platform video tour',
    architectureAlt: 'Operator at work in an industrial plant',
    casesHeading: 'Case studies',
    casesSub: 'See how other companies use Open EAM to improve efficiency and maintenance performance at their production plants.',
    casesExploreAll: 'Explore all case studies',
  },
} as const;
const t = COPY[lang];

const modules = [
  { href: l('/platform/asset-management'), icon: iconGear, image: featAsset, ...t.modules[0] },
  { href: l('/platform/maintenance-operations'), icon: iconWrench, image: featMaint, ...t.modules[1] },
  { href: l('/platform/technical-documentation'), icon: iconDocument, image: featDoc, ...t.modules[2] },
  { href: l('/platform/asset-analytics'), icon: iconChart, image: featAnalytics, ...t.modules[3] },
];

const cases = [
  { ...t.cases[0], href: l('/case-studies/st-microelectronics'), image: caseSt },
  { ...t.cases[1], href: l('/case-studies/sonatrach'), image: caseSonatrach },
  { ...t.cases[2], href: l('/case-studies/sasol'), image: caseSasol },
  { ...t.cases[3], href: l('/case-studies/sac'), image: caseSac },
];
---
<BaseLayout title={t.title} description={t.description}>

  <!-- Hero -->
  <section class="hero">
    <div class="hero__grid dotted-grid container-page">
      <div class="hero__text">
        <h1 class="hero__title">
          {t.heroTitleLead}<span class="hero__hl">{t.heroTitleHl}</span>
        </h1>
        <p class="hero__sub">
          {t.heroSub} <strong>{t.heroSubStrong}</strong>
        </p>
        <div class="hero__cta">
          <Button href={l('/demo')} variant="primary">{t.ctaDemo}</Button>
          <Button href={l('/demo')} variant="outline">{t.ctaVideoTour}</Button>
        </div>
      </div>
    </div>
    <Image src={heroRings} alt="" class="hero__rings" aria-hidden="true" />
  </section>

  <!-- Trust band -->
  <Section bg="teal">
    <LogoMarquee />
  </Section>

  <!-- Modules -->
  <Section bg="light" dotted>
    <SectionHeading heading={t.modulesHeading} sub={t.modulesSub} />
    <div class="modules">
      {modules.map((m, i) => (
        <ModuleCard
          icon={m.icon}
          title={m.heading}
          body={m.body}
          href={m.href}
          image={m.image}
          reverse={i % 2 === 1}
        />
      ))}
    </div>
    <div class="modules__cta">
      <Button href={l('/demo')} variant="teal">{t.ctaDemo}</Button>
    </div>
  </Section>

  <!-- Testimonial -->
  <Section bg="light">
    <Testimonial quote={t.testimonialQuote} author="Francesco Vassallo" company="Sonatrach" />
  </Section>

  <!-- Modular architecture band -->
  <Section bg="light">
    <CtaBand
      tone="ink"
      image={workerIndustry}
      imageAlt={t.architectureAlt}
      heading={t.architectureHeading}
      body={t.architectureBody}
      ctaLabel={t.architectureCta}
      ctaHref={l('/demo')}
    />
  </Section>

  <!-- Case studies -->
  <Section bg="light">
    <SectionHeading heading={t.casesHeading} sub={t.casesSub} />
    <div class="cases-grid">
      {cases.map((c) => (
        <CaseStudyCard title={c.title} href={c.href} image={c.image} imageAlt={c.title} body={c.body} />
      ))}
    </div>
    <div class="modules__cta">
      <Button href={l('/case-studies')} variant="outline-ink">{t.casesExploreAll}</Button>
    </div>
  </Section>

</BaseLayout>

<style>
  .hero { position: relative; background: var(--color-ink); overflow: hidden; }
  .hero__grid { padding-block: clamp(4rem, 10vw, 8rem); position: relative; z-index: 1; }
  .hero__text { max-width: 42rem; display: grid; gap: 2rem; }
  .hero__title { color: #fff; font-size: clamp(2.6rem, 6.5vw, 4.6rem); line-height: 1.03; }
  .hero__hl { color: var(--color-orange); }
  .hero__sub { color: rgb(255 255 255 / 0.9); font-size: 1.25rem; max-width: 46ch; line-height: 1.6; }
  .hero__sub strong { color: #fff; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero__title,
  .hero__sub,
  .hero__cta {
    animation: hero-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero__title { animation-delay: 0.05s; }
  .hero__sub { animation-delay: 0.16s; }
  .hero__cta { animation-delay: 0.27s; }
  .hero__rings {
    position: absolute;
    right: -5%;
    bottom: -10%;
    width: min(62%, 880px);
    height: auto;
    opacity: 1;
    pointer-events: none;
    z-index: 0;
  }
  @media (max-width: 860px) {
    .hero__rings { opacity: 0.22; right: -25%; bottom: -6%; width: 90%; }
  }

  .modules { display: grid; gap: 2rem; margin-top: 3.5rem; }
  .modules__cta { display: flex; justify-content: center; margin-top: 3rem; }

  .cases-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 3.5rem;
  }
  @media (max-width: 720px) { .cases-grid { grid-template-columns: 1fr; } }
</style>
