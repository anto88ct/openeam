---
import { Image } from 'astro:assets';

/** Teal trust band: heading + row of client logos (rendered white/monochrome). */
interface Props {
  heading: string;
  mono?: boolean;
}
const { heading, mono = true } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/logos/*.{png,svg}',
  { eager: true },
);
const order = ['stmicroelectronics', 'sonatrach', 'saras', 'sac', 'sasol'];
const logos = order
  .map((name) => {
    const key = Object.keys(files).find((p) => p.endsWith(`/${name}.png`) || p.endsWith(`/${name}.svg`));
    return key ? { name, src: files[key].default } : null;
  })
  .filter((x): x is { name: string; src: ImageMetadata } => x !== null);
---
<div class:list={['marquee', mono ? 'marquee--mono' : 'marquee--color']}>
  <p class="marquee__heading">{heading}</p>
  <div class="marquee__panel">
    <ul class="marquee__row">
      {logos.map((l) => (
        <li class="marquee__item">
          <Image src={l.src} alt={l.name} height={90} loading="eager" />
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .marquee { text-align: center; display: grid; gap: 2rem; }
  .marquee__heading {
    color: var(--color-slate-muted);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
  }
  .marquee__row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(3rem, 7vw, 9rem);
  }
  .marquee__item :global(img) {
    height: 65px;
    width: auto;
    object-fit: contain;
    transition: opacity 0.2s ease, filter 0.2s ease;
  }
  .marquee--mono .marquee__item :global(img) {
    /* Flatten every logo to a uniform gray mark, regardless of source color */
    filter: brightness(0);
    opacity: 0.45;
  }
  .marquee--mono .marquee__item:hover :global(img) { opacity: 0.7; }

  .marquee--color .marquee__item { transition: transform 0.2s ease; }
  .marquee--color .marquee__item:hover { transform: translateY(-2px); }

  .marquee--color .marquee__panel {
    padding: 2.5rem clamp(1.5rem, 5vw, 4rem);
    border-radius: 28px;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.22), rgb(255 255 255 / 0.06));
    border: 1px solid rgb(255 255 255 / 0.35);
    backdrop-filter: blur(20px) saturate(1.3);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    box-shadow:
      0 24px 48px -24px rgb(0 0 0 / 0.35),
      inset 0 1px 0 rgb(255 255 255 / 0.4);
  }
</style>
