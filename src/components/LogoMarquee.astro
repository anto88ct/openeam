---
import { Image } from 'astro:assets';

/** Teal trust band: heading + row of client logos (rendered white/monochrome). */
interface Props {
  heading: string;
}
const { heading } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/logos/*.{png,svg}',
  { eager: true },
);
const order = ['stmicroelectronics', 'sonatrach', 'saras', 'sac', 'sasol'];
const logos = order
  .map((name) => {
    const key = Object.keys(files).find((p) => p.endsWith(`/${name}.png`) || p.endsWith(`/${name}.svg`));
    return key ? { name, src: files[key].default } : null;
  })
  .filter((x): x is { name: string; src: ImageMetadata } => x !== null);
---
<div class="marquee">
  <p class="marquee__heading">{heading}</p>
  <ul class="marquee__row">
    {logos.map((l) => (
      <li class="marquee__item">
        <Image src={l.src} alt={l.name} height={90} loading="eager" />
      </li>
    ))}
  </ul>
</div>

<style>
  .marquee { text-align: center; display: grid; gap: 2rem; }
  .marquee__heading {
    color: var(--color-slate-muted);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
  }
  .marquee__row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(3rem, 7vw, 9rem);
  }
  .marquee__item :global(img) {
    height: 65px;
    width: auto;
    object-fit: contain;
    /* Flatten every logo to a uniform gray mark, regardless of source color */
    filter: brightness(0);
    opacity: 0.45;
    transition: opacity 0.2s ease;
  }
  .marquee__item:hover :global(img) { opacity: 0.7; }
</style>
