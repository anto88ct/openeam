---
import Button from './Button.astro';
import { getLocalizedPath } from '../i18n/utils';

interface Props {
  lang: 'it' | 'en';
  variant?: 'demo' | 'videoTour';
  successRedirect?: string;
  /** localStorage key to grant on successful submit, e.g. so a returning visitor skips the form for a while. */
  grantKey?: string;
  grantTtlMs?: number;
}
const { lang, variant = 'demo', successRedirect, grantKey, grantTtlMs } = Astro.props;
const l = (href: string) => getLocalizedPath(lang, href);

const COPY = {
  it: {
    roles: ['Direzione / C-Level', 'Responsabile Manutenzione', 'Responsabile Operations / Produzione', 'Facility / Asset Manager', 'IT / Sistemi Informativi', 'Altro'],
    firstName: 'Nome',
    lastName: 'Cognome',
    company: 'Azienda',
    role: 'Ruolo',
    selectPlaceholder: 'Seleziona...',
    email: 'Email aziendale',
    consentLead: "Acconsento al trattamento dei miei dati personali in conformità con l'",
    consentLinkText: 'Informativa sulla Privacy',
    submit: { demo: 'Richiedi la demo', videoTour: 'Accedi al video tour' },
    messages: {
      firstName: 'Inserisci il nome',
      lastName: 'Inserisci il cognome',
      company: "Inserisci l'azienda",
      role: 'Seleziona un ruolo',
      email: 'Inserisci un indirizzo email valido',
      emailBusiness: 'Inserire un indirizzo email aziendale',
      consent: 'Devi accettare il trattamento dei dati per proseguire.',
      configMissing: 'Configurazione email non completata. Imposta le variabili PUBLIC_EMAILJS_* (vedi README).',
      sending: 'Invio in corso...',
      error: "Si è verificato un errore nell'invio. Riprova più tardi.",
    },
    success: {
      demo: 'Grazie! Ti contatteremo a breve per fissare la demo.',
      videoTour: 'Grazie! Riceverai il link al video tour a breve.',
    },
  },
  en: {
    roles: ['Management / C-Level', 'Maintenance Manager', 'Operations / Production Manager', 'Facility / Asset Manager', 'IT / Information Systems', 'Other'],
    firstName: 'First name',
    lastName: 'Last name',
    company: 'Company',
    role: 'Role',
    selectPlaceholder: 'Select...',
    email: 'Business email',
    consentLead: 'I consent to the processing of my personal data in accordance with the ',
    consentLinkText: 'Privacy Policy',
    submit: { demo: 'Request the demo', videoTour: 'Access the video tour' },
    messages: {
      firstName: 'Enter your first name',
      lastName: 'Enter your last name',
      company: 'Enter your company',
      role: 'Select a role',
      email: 'Enter a valid email address',
      emailBusiness: 'Please enter a business email address',
      consent: 'You must accept the data processing terms to continue.',
      configMissing: 'Email configuration incomplete. Set the PUBLIC_EMAILJS_* variables (see README).',
      sending: 'Sending...',
      error: 'Something went wrong while sending. Please try again later.',
    },
    success: {
      demo: "Thank you! We'll be in touch shortly to schedule your demo.",
      videoTour: "Thank you! We'll send you the video tour link shortly.",
    },
  },
} as const;
const t = COPY[lang];
const submitLabel = t.submit[variant];
const successMessage = t.success[variant];
const privacyHref = l('/privacy-policy');
const variantLabel = {
  it: { demo: 'Richiesta Demo', videoTour: 'Richiesta Video Tour' },
  en: { demo: 'Demo Request', videoTour: 'Video Tour Request' },
}[lang][variant];
---
<form
  class="demo-form"
  data-demo-form
  data-msgs={JSON.stringify({ ...t.messages, success: successMessage })}
  data-redirect={successRedirect ?? ''}
  data-grant-key={grantKey ?? ''}
  data-grant-ttl={grantTtlMs ?? ''}
  novalidate
>
  <input type="hidden" name="tipo_richiesta" value={variantLabel} />
  <input type="hidden" name="is_video_tour" value={variant === 'videoTour' ? 'true' : ''} />
  <div class="demo-form__row">
    <div class="field">
      <label for="nome">{t.firstName}</label>
      <input id="nome" name="nome" type="text" autocomplete="given-name" required />
      <small class="field__err" data-err></small>
    </div>
    <div class="field">
      <label for="cognome">{t.lastName}</label>
      <input id="cognome" name="cognome" type="text" autocomplete="family-name" required />
      <small class="field__err" data-err></small>
    </div>
  </div>

  <div class="field">
    <label for="azienda">{t.company}</label>
    <input id="azienda" name="azienda" type="text" autocomplete="organization" required />
    <small class="field__err" data-err></small>
  </div>

  <div class="field">
    <label for="ruolo">{t.role}</label>
    <select id="ruolo" name="ruolo" required>
      <option value="" disabled selected>{t.selectPlaceholder}</option>
      {t.roles.map((r) => <option value={r}>{r}</option>)}
    </select>
    <small class="field__err" data-err></small>
  </div>

  <div class="field">
    <label for="email">{t.email}</label>
    <input id="email" name="email" type="email" autocomplete="email" required />
    <small class="field__err" data-err></small>
  </div>

  <label class="consent">
    <input type="checkbox" name="consenso" required />
    <span>{t.consentLead}<a href={privacyHref}>{t.consentLinkText}</a>.</span>
  </label>

  <Button type="submit" variant="primary" class="demo-form__submit">{submitLabel}</Button>

  <p class="demo-form__status" data-status role="status" aria-live="polite" hidden></p>
</form>

<style>
  .demo-form { display: grid; gap: 1.25rem; }
  .demo-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .field { display: grid; gap: 0.4rem; }
  .field label { font-weight: 700; color: var(--color-ink); font-size: 0.95rem; }
  .field input,
  .field select {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1.5px solid #c9d0d6;
    border-radius: 12px;
    font: inherit;
    font-size: 1rem;
    color: var(--color-ink);
    background: #fff;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .field input:focus,
  .field select:focus {
    outline: none;
    border-color: var(--color-orange);
    box-shadow: 0 0 0 3px rgb(255 91 4 / 0.15);
  }
  .field[data-invalid] input,
  .field[data-invalid] select { border-color: #d64545; }
  .field__err { color: #d64545; font-size: 0.8rem; min-height: 0; }

  .consent {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    font-size: 0.85rem;
    color: var(--color-slate-muted);
  }
  .consent input { margin-top: 0.2rem; width: 1.05rem; height: 1.05rem; accent-color: var(--color-orange); }
  .consent a { color: var(--color-orange); text-decoration: underline; }

  .demo-form__submit { width: 100%; margin-top: 0.25rem; }
  .demo-form__status { font-size: 0.95rem; padding: 0.85rem 1rem; border-radius: 12px; }
  .demo-form__status[data-tone='ok'] { background: #e7f4ee; color: #1c6b46; }
  .demo-form__status[data-tone='err'] { background: #fbe9e9; color: #a3272b; }

  @media (max-width: 560px) {
    .demo-form__row { grid-template-columns: 1fr; }
  }
</style>

<script>
  import emailjs from '@emailjs/browser';

  interface Messages {
    firstName: string;
    lastName: string;
    company: string;
    role: string;
    email: string;
    emailBusiness: string;
    consent: string;
    configMissing: string;
    sending: string;
    success: string;
    error: string;
  }

  const SERVICE_ID = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID;
  const TEMPLATE_ID = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID;
  const PUBLIC_KEY = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY;

  const form = document.querySelector<HTMLFormElement>('[data-demo-form]');
  const statusEl = form?.querySelector<HTMLElement>('[data-status]');
  const msgs: Messages = JSON.parse(form?.dataset.msgs ?? '{}');

  const submitBtn = form?.querySelector<HTMLButtonElement>('[type="submit"]');

  function updateSubmitState() {
    if (!form || !submitBtn) return;
    submitBtn.disabled = !!form.querySelector('.field[data-invalid]');
  }

  function setError(field: Element | null, msg: string) {
    if (!field) return;
    const wrap = field.closest('.field');
    wrap?.toggleAttribute('data-invalid', !!msg);
    const err = wrap?.querySelector('[data-err]');
    if (err) err.textContent = msg;
    updateSubmitState();
  }

  const FREE_EMAIL_DOMAINS = new Set([
    'gmail.com', 'outlook.com', 'hotmail.com', 'hotmail.it', 'icloud.com',
    'yahoo.it', 'yahoo.com', 'libero.it', 'tiscali.it', 'virgilio.it',
    'alice.it', 'fastwebnet.it', 'proton.me', 'protonmail.com',
  ]);

  function validateEmailField(email: HTMLInputElement | null): boolean {
    const emailValue = email?.value.trim() ?? '';
    const emailFormatOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailValue);
    const domain = emailValue.split('@')[1]?.toLowerCase();
    const isFreeEmail = !!domain && FREE_EMAIL_DOMAINS.has(domain);
    const emailOk = emailFormatOk && !isFreeEmail;
    setError(email, emailOk ? '' : isFreeEmail ? msgs.emailBusiness : msgs.email);
    return emailOk;
  }

  function validate(): boolean {
    if (!form) return false;
    let ok = true;
    const required: [string, string][] = [
      ['nome', msgs.firstName],
      ['cognome', msgs.lastName],
      ['azienda', msgs.company],
      ['ruolo', msgs.role],
    ];
    for (const [name, msg] of required) {
      const el = form.elements.namedItem(name) as HTMLInputElement | null;
      const bad = !el?.value.trim();
      setError(el, bad ? msg : '');
      if (bad) ok = false;
    }
    const email = form.elements.namedItem('email') as HTMLInputElement | null;
    if (!validateEmailField(email)) ok = false;

    const consent = form.elements.namedItem('consenso') as HTMLInputElement | null;
    if (!consent?.checked) {
      showStatus(msgs.consent, 'err');
      ok = false;
    }
    return ok;
  }

  function showStatus(msg: string, tone: 'ok' | 'err') {
    if (!statusEl) return;
    statusEl.hidden = false;
    statusEl.textContent = msg;
    statusEl.setAttribute('data-tone', tone);
  }

  const requiredFields: [string, string][] = [
    ['nome', msgs.firstName],
    ['cognome', msgs.lastName],
    ['azienda', msgs.company],
    ['ruolo', msgs.role],
  ];
  for (const [name, msg] of requiredFields) {
    const el = form?.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
    const revalidate = () => setError(el, el?.value.trim() ? '' : msg);
    el?.addEventListener('blur', revalidate);
    el?.addEventListener('input', revalidate);
    el?.addEventListener('change', revalidate);
  }

  const emailInput = form?.elements.namedItem('email') as HTMLInputElement | null;
  emailInput?.addEventListener('blur', () => validateEmailField(emailInput));
  emailInput?.addEventListener('input', () => {
    if (emailInput.closest('.field')?.hasAttribute('data-invalid')) validateEmailField(emailInput);
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (statusEl) statusEl.hidden = true;
    if (!validate()) return;

    const submit = form.querySelector<HTMLButtonElement>('[type="submit"]');
    if (!SERVICE_ID || !TEMPLATE_ID || !PUBLIC_KEY) {
      showStatus(msgs.configMissing, 'err');
      return;
    }

    submit?.setAttribute('disabled', 'true');
    const original = submit?.textContent;
    if (submit) submit.textContent = msgs.sending;

    try {
      await emailjs.sendForm(SERVICE_ID, TEMPLATE_ID, form, { publicKey: PUBLIC_KEY });

      const grantKey = form.dataset.grantKey;
      const grantTtl = Number(form.dataset.grantTtl);
      if (grantKey && grantTtl > 0) {
        try {
          localStorage.setItem(grantKey, JSON.stringify({ expires: Date.now() + grantTtl }));
        } catch (storageErr) {
          console.error('[VideoTourAccess]', storageErr);
        }
      }

      const redirect = form.dataset.redirect;
      if (redirect) {
        window.location.href = redirect;
        return;
      }
      form.reset();
      showStatus(msgs.success, 'ok');
    } catch (err) {
      console.error('[EmailJS]', err);
      showStatus(msgs.error, 'err');
    } finally {
      submit?.removeAttribute('disabled');
      if (submit && original) submit.textContent = original;
    }
  });
</script>
