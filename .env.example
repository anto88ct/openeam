# EmailJS — client-side demo form (see src/components/ContactForm.astro)
# Create a free account at https://www.emailjs.com/, add an email service + template,
# then copy the three public identifiers here. All are PUBLIC (safe to ship to the browser).
PUBLIC_EMAILJS_SERVICE_ID=your_service_id
PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
